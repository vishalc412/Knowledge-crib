ule/mule3.test.ts\ngit commit -m \"feat(parsers): normalize Mule 3 flows\"","expect","doc.flows",".processors.map","p.semanticKind",".toEqual","operation","router","outbound","call",".errorHandlers.map","h.strategy","catch","rollback","export","interface","Mule3Document","extends","Omit","MuleDocument","dialect","mule3","function","parseMule3","string","const","xml","parseMuleXml","return","normalizeMule3","MuleXmlDocument","imports","collectMule3Imports","xml.root","configurations","collectMule3Configurations","flows","collectMule3Flows","diagnostics","xml.diagnostics","git","add","commit","feat","parsers","normalize","Mule"],"links":[]}}
