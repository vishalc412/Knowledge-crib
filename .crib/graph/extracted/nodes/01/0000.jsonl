{"id":"stmt:packages/pipeline/src/parse-concurrent.test.ts@L74","kind":"statement","type":"assign","expr":"const walk = (dir: string, rel: string) => {\n    for (const name of readdirSync(dir).sort()) {\n      const abs = join(dir, name);\n      const r = rel === '.crib' ? `.crib/${name}` : `${rel}/${name}`;\n      // skip gitignored DERIVED state (sqlite index + embeddings dirs) — never committed, not what\n      // parse produces. Only snapshot the soul shards (nodes/edges/manifest) + cluster topology.\n      if (r === '.crib/index' || r === '.crib/embeddings') continue;\n      if (statSync(abs).isDirectory()) {\n        walk(abs, r);\n        continue;\n      }\n      out.push(r);\n      out.push(readFileSync(abs, 'utf8'));\n    }\n  };","file":"packages/pipeline/src/parse-concurrent.test.ts","span":{"start":74,"end":74},"lang":"typescript","hash":"blake3:c980d892fe86e0562ce45c77d0b1a6e73cb3c989392d193059c5efdc34aae7df","meta":{"head":"call","inLoop":false,"inException":false}}
