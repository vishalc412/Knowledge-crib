{"id":"stmt:packages/parsers/src/mule/xml.ts@L108","kind":"statement","type":"call","expr":"parser.on('closetag', () => {\n    // saxes fires this after reading the closing `>`; the parser line is still the line of that\n    // `>` (the trailing newline has not been consumed yet), so this is the span end we want.\n    const el = stack.pop();\n    if (el) el.endLine = parser.line;\n  });","file":"packages/parsers/src/mule/xml.ts","span":{"start":108,"end":108},"lang":"typescript","hash":"blake3:246630c3eb375b4dcfa40d15ac88bea67f8f296d1a96a4e2bd6603a0c6e58825","meta":{"head":"call","inLoop":false,"inException":false}}
{"id":"stmt:packages/parsers/src/mule/xml.ts@L115","kind":"statement","type":"call","expr":"parser.on('text', (text: string) => {\n    if (text.length === 0) return;\n    // Whitespace between the `<?xml …?>` declaration and the root element (and trailing whitespace\n    // after the root closes) is legal XML prolog/epilog — every real Mule config and pom.xml starts\n    // with `<?xml?>\\n<mule>`. Ignore whitespace-only text outside the root; only non-whitespace text\n    // outside the root is genuinely malformed.\n    if (stack.length === 0 && text.trim() === '') return;\n    top().text += text;\n  });","file":"packages/parsers/src/mule/xml.ts","span":{"start":115,"end":115},"lang":"typescript","hash":"blake3:c8053a448e35108e0f40dddacbcd25b8b4df66ad7bcae638e28fd4949e0df259","meta":{"head":"call","inLoop":false,"inException":false}}
