{"id":"stmt:packages/parsers/src/mule/xml.ts@L68","kind":"statement","type":"call","expr":"parser.on('opentagstart', () => {\n    // saxes fires this once the tag name is read (before attributes / `>`). The parser line at this\n    // point is the line of the `<tag` — the span start we want. There cannot be a nested opentag\n    // before the matching opentag, so a single pending slot is safe.\n    pendingStartLine = parser.line;\n  });","file":"packages/parsers/src/mule/xml.ts","span":{"start":68,"end":68},"lang":"typescript","hash":"blake3:92ca99084e73964ee41b312f539f5c1a0a1b16393843d134697a33b49d822ed2","meta":{"head":"call","inLoop":false,"inException":false}}
{"id":"stmt:packages/parsers/src/mule/xml.ts@L75","kind":"statement","type":"call","expr":"parser.on('opentag', (tag: SaxesTagNS) => {\n    elementCount++;\n    if (elementCount > MAX_ELEMENTS) {\n      fail(`element count exceeds limit (${MAX_ELEMENTS})`);\n    }\n    const depth = stack.length + 1;\n    if (depth > MAX_DEPTH) {\n      fail(`nesting depth exceeds limit (${MAX_DEPTH})`);\n    }\n    const attributes: MuleXmlAttribute[] = [];\n    for (const key of Object.keys(tag.attributes)) {\n      const a = tag.attributes[key];\n      if (!a) continue;\n      attributes.push({ uri: a.uri, local: a.local, value: a.value });\n    }\n    const el: MuleXmlElement = {\n      uri: tag.uri,\n      local: tag.local,\n      prefix: tag.prefix,\n      attributes,\n      children: [],\n      text: '',\n      startLine: pendingStartLine,\n      endLine: pendingStartLine,\n    };\n    if (stack.length > 0) {\n      stack[stack.length - 1]!.children.push(el);\n    } else {\n      root = el;\n    }\n    stack.push(el);\n  });","file":"packages/parsers/src/mule/xml.ts","span":{"start":75,"end":75},"lang":"typescript","hash":"blake3:39c67b68dffe2a9fa07f0f9f33e230f9de66761e422e9230211d486381dc8c4f","meta":{"head":"call","inLoop":false,"inException":false}}
