{"id":"stmt:packages/core/src/source-policy.ts@L54","kind":"statement","type":"return","expr":"return text\n    .split(/\\r?\\n/)\n    .map((line) => {\n      const trimmed = line.trim();\n      if (!trimmed || trimmed.startsWith('#') || trimmed.startsWith('!')) return '';\n      const at = line.search(/[:=]/);\n      return at < 0 ? `${trimmed}=<redacted>` : `${line.slice(0, at).trim()}=<redacted>`;\n    })\n    .filter(Boolean)\n    .join('\\n');","file":"packages/core/src/source-policy.ts","span":{"start":54,"end":54},"lang":"typescript","hash":"blake3:112b0986fc47396984fba37a7a5b8adfe5ed1502c442e88bb8cd958769ee1f7f","meta":{"head":"return","inLoop":false,"inException":false}}
{"id":"stmt:packages/core/src/source-policy.ts@L74","kind":"statement","type":"return","expr":"return text.replace(\n    /([:\\w.-]+)\\s*=\\s*([\"'])(.*?)\\2/g,\n    (whole, name: string, quote: string, value: string) => {\n      if (!secret.test(name)) return whole;\n      const placeholder = value.match(/^\\$\\{([^}]+)\\}$/)?.[1] ?? value.match(/^secure::(.+)$/)?.[1];\n      return `${name}=${quote}${placeholder ? `\\${${placeholder}}` : '<redacted>'}${quote}`;\n    },\n  );","file":"packages/core/src/source-policy.ts","span":{"start":74,"end":74},"lang":"typescript","hash":"blake3:72515348d36644c2fb3af0f28ccd75fdc7c2441c3ca565fd44976b6e1fcad59d","meta":{"head":"return","inLoop":false,"inException":false}}
