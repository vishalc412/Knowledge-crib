{"id":"expl:packages/core/src/embeddings/types.ts@L24","kind":"explanation","commentRef":{"file":"packages/core/src/embeddings/types.ts","span":{"start":24,"end":27}},"file":"packages/core/src/embeddings/types.ts","span":{"start":24,"end":27},"lang":"typescript","hash":"blake3:b914250a712c0a67b428309d87ba57a8abad6f7e391beb52fc6fca9511179714","meta":{"text":"A deterministic, dependency-free text embedder. The default impl is pure JS; an external provider\nimplements this to plug a neural embedder in via `KCRIB_EMBEDDER`."}}
