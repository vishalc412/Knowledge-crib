  "source": {
    "text": "function costFromLayers(layers: Record<EnrichLayer, EnrichLayerCounts>): {\n  currency: 'tokens';\n  pending: number;\n  total: number;\n} {\n  let pending = 0;\n  let total = 0;\n  for (const layer of LAYERS) {\n    const l = layers[layer];\n    const rate = HEURISTIC_TOKENS_PER_LAYER[layer];\n    pending += (l.missing + l.stale) * rate;\n    total += l.total * rate;\n  }\n  return { currency: 'tokens', pending, total };\n}",
    "truncated": false,
    "totalLines": 15,
    "startLine": 1876
  },
