  "source": {
    "text": "  private consumeVisibility(): string {\n    const tok = this.peek();\n    this.next(); // pub\n    if (this.isOp('(')) {\n      // capture the parens content as `pub(...)`\n      const start = this.i; // at '('\n      this.skipBalancedParens(); // advances past ')'\n      const end = this.i; // past ')'\n      // slice(start+1, end-1) excludes the '(' and ')' themselves\n      const inner = this.t\n        .slice(start + 1, end - 1)\n        .map((x) => x.value)\n        .join('');\n      return `pub(${inner})`;\n    }\n    return tok.value;\n  }",
    "truncated": false,
    "totalLines": 17,
    "startLine": 345
  },
