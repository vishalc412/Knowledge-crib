  "source": {
    "text": "  private findErrCall(start: number, end: number): number {\n    for (let k = start; k < end; k++) {\n      const tk = this.t[k]!;\n      if (tk.type === 'NAME' && tk.value === 'Err') {\n        const next = this.t[k + 1];\n        if (next?.type === 'OP' && next.value === '(') return k;\n      }\n    }\n    return -1;\n  }",
