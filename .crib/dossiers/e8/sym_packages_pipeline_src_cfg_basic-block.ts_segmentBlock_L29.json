  "source": {
    "text": "export function segmentBlock(block: Block): BasicBlock[] {\n  const blocks: BasicBlock[] = [];\n  let run: Stmt[] = [];\n  for (const s of block.statements) {\n    if (isCompound(s)) {\n      if (run.length > 0) {\n        blocks.push({ statements: run });\n        run = [];\n      }\n    } else {\n      run.push(s);\n    }\n  }\n  if (run.length > 0) blocks.push({ statements: run });\n  return blocks;\n}",
    "truncated": false,
    "totalLines": 16,
    "startLine": 29
  },
