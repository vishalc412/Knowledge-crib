  "source": {
    "text": "export function clusterImportance(\n  soul: SoulStore,\n  cluster: Node,\n  importance: Map<string, ImportanceEntry>,\n): number {\n  const memberIds = new Set(cluster.members ?? []);\n  let sum = 0;\n  for (const id of memberIds) {\n    sum += importance.get(id)?.importance ?? 0;\n  }\n  return sum;\n}",
    "truncated": false,
