  "source": {
    "text": "function allQuoted(s?: string): string[] {\n  if (!s) return [];\n  const out: string[] = [];\n  const re = /\"([^\"]*)\"/g;\n  let m: RegExpExecArray | null;\n  while ((m = re.exec(s)) !== null) out.push(m[1]!);\n  return out;\n}",
