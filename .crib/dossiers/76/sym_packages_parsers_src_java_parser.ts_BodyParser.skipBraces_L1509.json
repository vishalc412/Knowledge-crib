  "source": {
    "text": "  private skipBraces(): void {\n    if (!this.isOp('{')) return;\n    const closeIdx = this.matchBrace(this.i, this.end);\n    this.i = closeIdx < 0 ? this.end : closeIdx + 1;\n  }",
