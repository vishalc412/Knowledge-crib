  "source": {
    "text": "const runCrib = (repo, args) => {\n  try {\n    const out = execFileSync(process.execPath, [CLI, ...args], {\n      cwd: repo,\n      encoding: 'utf8',\n      stdio: ['ignore', 'pipe', 'pipe'],\n      env: { ...process.env, NO_COLOR: '1' },\n    });\n    return { code: 0, out };\n  } catch (err) {\n    return { code: err.status ?? 1, out: (err.stdout ?? '') + (err.stderr ?? '') };\n  }\n};",
