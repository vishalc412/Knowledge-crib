  "source": {
    "text": "  function shallowEqual(a, b) {\n    if (!b) return false;\n    const ak = Object.keys(a).filter((k) => k !== \"children\");\n    const bk = Object.keys(b).filter((k) => k !== \"children\");\n    if (ak.length !== bk.length) return false;\n    for (const k of ak) if (a[k] !== b[k]) return false;\n    return true;\n  }",
