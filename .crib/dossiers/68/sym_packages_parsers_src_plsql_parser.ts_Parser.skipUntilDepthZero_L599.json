  "source": {
    "text": "  private skipUntilDepthZero(): void {\n    let depth = 0;\n    while (this.at().type !== 'eof') {\n      if (this.isPunct('(')) depth++;\n      else if (this.isPunct(')')) {\n        if (depth === 0) return; // caller's closing paren\n        depth--;\n      } else if (this.isPunct(',') && depth === 0) {\n        return;\n      }\n      this.pos++;\n    }\n  }",
    "truncated": false,
    "totalLines": 13,
    "startLine": 599
  },
