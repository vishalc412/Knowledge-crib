  "source": {
    "text": "export function installedBinCommand(bin, platform = process.platform, env = process.env) {\n  if (platform === 'win32') {\n    return {\n      command: env.ComSpec || 'cmd.exe',\n      args: ['/d', '/s', '/c', `\"${bin}\" --help`],\n    };\n  }\n\n  return { command: bin, args: ['--help'] };\n}",
