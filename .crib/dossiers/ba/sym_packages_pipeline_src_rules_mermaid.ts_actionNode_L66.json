  "source": {
    "text": "function actionNode(nid: (k: string) => string, r: RuleRecord): string {\n  const a = r.action;\n  const id = nid(`act:${a.edgeId}`);\n  const head =\n    a.kind === 'calls'\n      ? `call ${a.expr ?? a.target}`\n      : `${a.sqlKind ?? 'stmt'}${a.expr ? `: ${a.expr}` : ''}`;\n  // \"[\" => rounded rect node shape; quoted text keeps SQL safe\n  return `${id}[\"${head.replace(/\"/g, \"'\")}\"]`;\n}",
    "truncated": false,
    "totalLines": 10,
    "startLine": 66
  },
