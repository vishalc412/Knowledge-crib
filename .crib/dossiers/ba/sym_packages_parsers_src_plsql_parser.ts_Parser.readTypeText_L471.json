  "source": {
    "text": "  private readTypeText(): string {\n    const parts: string[] = [];\n    while (\n      this.at().type !== 'eof' &&\n      !this.isPunct(',') &&\n      !this.isPunct(';') &&\n      !this.isPunct(')')\n    ) {\n      if (this.at().type === 'word' || this.at().type === 'number') parts.push(this.at().raw);\n      this.pos++;\n    }\n    return parts.join(' ');\n  }",
    "truncated": false,
