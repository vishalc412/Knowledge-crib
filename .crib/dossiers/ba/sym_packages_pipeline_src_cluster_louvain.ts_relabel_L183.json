  "source": {
    "text": "function relabel(communities: Int32Array): Int32Array {\n  const map = new Map<number, number>();\n  let next = 0;\n  const out = new Int32Array(communities.length);\n  for (let i = 0; i < communities.length; i++) {\n    const c = communities[i]!;\n    let v = map.get(c);\n    if (v === undefined) {\n      v = next++;\n      map.set(c, v);\n    }\n    out[i] = v;\n  }\n  return out;\n}",
    "truncated": false,
    "totalLines": 15,
    "startLine": 183
  },
