  "source": {
    "text": "  private parseTypeAlias(\n    startLine: number,\n    attributes: string[],\n    modifiers: string[],\n  ): RustDef | null {\n    this.next(); // type\n    if (!this.isNameToken()) return null;\n    const name = this.peek().value;\n    this.next();\n    this.skipGenericAngle();\n    let endLine = startLine;\n    // `type Name = ...;` or in traits `type Name: Bound;` / `type Name = default;`\n    while (!this.atEnd() && !this.isOp(';') && !this.isOp('{')) this.next();\n    if (this.isOp('{')) {\n      endLine = this.skipBraces(); // `type Name<T> = where ... { ... }`? tolerate\n    } else if (this.isOp(';')) {\n      this.next();\n      endLine = this.peek().line;\n    }\n    return {\n      kind: 'typealias',\n      name,\n      startLine,\n      endLine: Math.max(endLine, startLine),\n      modifiers,\n      attributes,\n      bases: [],\n      typeParams: [],\n      params: [],\n      hasSelf: false,\n      body: [],\n    };\n  }",
    "truncated": false,
    "totalLines": 33,
    "startLine": 566
  },
