  "source": {
    "text": "function extractCwdFlag(argv: string[]): { argv: string[]; cwdOverride?: string } {\n  const out: string[] = [];\n  let cwdOverride: string | undefined;\n  for (let i = 0; i < argv.length; i++) {\n    if (argv[i] === '--cwd') {\n      cwdOverride = argv[++i];\n      continue;\n    }\n    out.push(argv[i]!);\n  }\n  return { argv: out, cwdOverride };\n}",
    "truncated": false,
