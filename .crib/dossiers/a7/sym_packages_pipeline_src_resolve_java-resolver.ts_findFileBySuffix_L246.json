  "source": {
    "text": "function findFileBySuffix(\n  module: string,\n  name: string,\n  parsed: readonly ParsedFile[],\n): string | undefined {\n  const suffix = `${module.replace(/\\./g, '/')}/${name}.java`;\n  return parsed.find((p) => p.path === suffix || p.path.endsWith(`/${suffix}`))?.path;\n}",
