  "source": {
    "text": "function writeJsonAtomic(path: string, value: unknown): void {\n  const tmp = `${path}.tmp`;\n  mkdirSync(dirname(path), { recursive: true });\n  writeFileSync(tmp, `${JSON.stringify(value, null, 2)}\\n`, 'utf8');\n  renameSync(tmp, path);\n}",
