    "text": "export function isDefaultProvider(opts: EmbedderOptions = {}): boolean {\n  const id = opts.provider ?? process.env.KCRIB_EMBEDDER ?? 'char-ngram';\n  return CHAR_NGRAM.test(id) || BUILTIN.test(id);\n}",
