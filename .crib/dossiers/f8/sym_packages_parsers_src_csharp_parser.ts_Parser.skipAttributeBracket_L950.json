  "source": {
    "text": "  private skipAttributeBracket(): void {\n    if (!this.isOp('[')) return;\n    let depth = 0;\n    while (!this.atEnd()) {\n      if (this.isOp('[')) depth++;\n      else if (this.isOp(']')) {\n        depth--;\n        this.next();\n        if (depth === 0) return;\n        continue;\n      }\n      this.next();\n    }\n  }",
