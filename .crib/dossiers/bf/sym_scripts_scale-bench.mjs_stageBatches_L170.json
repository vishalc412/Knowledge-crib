  "source": {
    "text": "function stageBatches(nBatches) {\n  const root = mkdtempSync(join(tmpdir(), 'crib-scale-'));\n  for (let i = 0; i < nBatches; i++) cpSync(FIX, join(root, `batch${i}`), { recursive: true });\n  return root;\n}",
