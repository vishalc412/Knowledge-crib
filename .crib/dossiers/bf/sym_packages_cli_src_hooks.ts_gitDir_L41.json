  "source": {
    "text": "export function gitDir(root: string): string {\n  const rel = execFileSync('git', ['-C', root, 'rev-parse', '--git-dir'], {\n    encoding: 'utf8',\n    stdio: ['ignore', 'pipe', 'ignore'],\n  }).trim();\n  return resolve(root, rel);\n}",
