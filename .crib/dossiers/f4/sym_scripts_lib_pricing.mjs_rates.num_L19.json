  "source": {
    "text": "  const num = (key, fallback) => {\n    const raw = env[key];\n    if (raw === undefined || raw === '') return fallback;\n    const v = Number(raw);\n    if (!Number.isFinite(v) || v < 0) {\n      throw new Error(`${key} must be a non-negative number, got ${JSON.stringify(raw)}`);\n    }\n    return v;\n  };",
