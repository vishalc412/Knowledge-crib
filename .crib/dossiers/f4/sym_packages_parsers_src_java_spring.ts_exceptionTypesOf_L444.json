    "text": "function exceptionTypesOf(s?: string): string | undefined {\n  if (!s) return undefined;\n  const out: string[] = [];\n  const re = /(\\w+)\\.class/g;\n  let m: RegExpExecArray | null;\n  while ((m = re.exec(s)) !== null) out.push(m[1]!);\n  return out.length ? out.join('|') : undefined;\n}",
