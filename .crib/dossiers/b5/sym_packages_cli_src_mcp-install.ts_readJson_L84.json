    "text": "function readJson(path: string): Record<string, unknown> {\n  if (!existsSync(path)) return {};\n  try {\n    return JSON.parse(readFileSync(path, 'utf8')) as Record<string, unknown>;\n  } catch {\n    return {};\n  }\n}",
