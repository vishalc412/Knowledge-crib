    "text": "function toFtsMatch(text: string): string | undefined {\n  const tokens = text\n    .split(/[^A-Za-z0-9_]+/)\n    .filter((t) => t.length > 0)\n    .map((t) => `\"${t}\"*`);\n  return tokens.length > 0 ? tokens.join(' OR ') : undefined;\n}",
