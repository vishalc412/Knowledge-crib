  "source": {
    "text": "  private walkSwitch(\n    s: JavaStmt,\n    procId: string,\n    guardStack: string[],\n    inLoop: boolean,\n    inException: boolean,\n  ): void {\n    for (const c of s.cases ?? []) {\n      const cbId = this.caseBranch(c.predicate, c.line);\n      this.walkBody(c.body ?? [], procId, [...guardStack, cbId], 'CASE', inLoop, inException);\n    }\n  }",
