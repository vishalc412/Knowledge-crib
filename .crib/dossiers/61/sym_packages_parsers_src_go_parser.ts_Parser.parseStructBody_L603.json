  "source": {
    "text": "  private parseStructBody(): { bases: string[]; closeLine: number } {\n    const bases: string[] = [];\n    let closeLine = this.peek().line;\n    let seg: Token[] = [];\n    while (!this.atEnd()) {\n      const tk = this.peek();\n      if (this.isOp('}')) {\n        closeLine = tk.line;\n        this.analyzeStructSegment(seg, bases);\n        this.next();\n        break;\n      }\n      if (this.isOp(';')) {\n        this.analyzeStructSegment(seg, bases);\n        seg = [];\n        this.next();\n        continue;\n      }\n      seg.push(tk);\n      this.next();\n    }\n    return { bases, closeLine };\n  }",
    "truncated": false,
    "totalLines": 23,
    "startLine": 603
  },
