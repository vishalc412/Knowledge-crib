  "source": {
    "text": "function cleanAssignTarget(s: string): string {\n  let depth = 0;\n  for (let i = 0; i < s.length; i++) {\n    const c = s[i]!;\n    if (c === '(' || c === '[' || c === '{') depth++;\n    else if (c === ')' || c === ']' || c === '}') depth = Math.max(0, depth - 1);\n    else if (c === ':' && depth === 0) return s.slice(0, i).trim();\n  }\n  return s.trim();\n}",
    "truncated": false,
    "totalLines": 10,
    "startLine": 1014
  },
