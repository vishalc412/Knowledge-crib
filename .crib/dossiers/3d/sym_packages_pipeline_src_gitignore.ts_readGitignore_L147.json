  "source": {
    "text": "export function readGitignore(root: string, dir: string): GitignoreRule[] {\n  const path = dir === '' ? join(root, '.gitignore') : join(root, dir, '.gitignore');\n  if (!existsSync(path)) return [];\n  try {\n    return parseGitignore(readFileSync(path, 'utf8'));\n  } catch {\n    return [];\n  }\n}",
    "truncated": false,
