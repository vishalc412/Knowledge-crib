  "source": {
    "text": "const exposes = (r: ExtractResult): string[] => {\n  const lbl = label(r);\n  const routeById = new Map(r.nodes.filter((n) => n.kind === 'route').map((n) => [n.id, n]));\n  return r.edges\n    .filter((e) => e.rel === 'exposes')\n    .map((e) => `${lbl(e.src)} -> ${routeById.get(e.dst)?.name ?? e.dst}`)\n    .sort();\n};",
    "truncated": false,
