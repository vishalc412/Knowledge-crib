  "source": {
    "text": "  private scanOp(): void {\n    const c = this.peek();\n    const startLine = this.line;\n    const startCol = this.col;\n    // brackets affect line-joining\n    if (c === '(' || c === '[' || c === '{') {\n      this.bracketDepth++;\n      this.emit('OP', c, startLine, startCol);\n      this.advance();\n      return;\n    }\n    if (c === ')' || c === ']' || c === '}') {\n      if (this.bracketDepth > 0) this.bracketDepth--;\n      this.emit('OP', c, startLine, startCol);\n      this.advance();\n      return;\n    }\n    // multi-char operators we may care about (=> n/a in Python, but `**`, `//`, `->`, `:=` etc.)\n    const two = c + (this.peek(1) ?? '');\n    if (\n      two === '**' ||\n      two === '//' ||\n      two === '->' ||\n      two === ':=' ||\n      two === '==' ||\n      two === '!=' ||\n      two === '>=' ||\n      two === '<=' ||\n      two === '<<' ||\n      two === '>>' ||\n      two === '&&' ||\n      two === '||' ||\n      two === '...'\n    ) {\n      this.emit('OP', two, startLine, startCol);\n      this.advance();\n      this.advance();\n      return;\n    }\n    this.emit('OP', c, startLine, startCol);\n    this.advance();\n  }",
    "truncated": false,
    "totalLines": 42,
