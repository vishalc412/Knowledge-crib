  "source": {
    "text": "  private condition(expr: string | undefined, line: number, branch: string): string {\n    const id = this.ctx.idFor('condition', { file: this.path, line });\n    if (!this.condSeen.has(id)) {\n      this.condSeen.add(id);\n      this.nodes.push({\n        id,\n        kind: 'condition',\n        branch,\n        ...exprFields(expr),\n        file: this.path,\n        span: { start: line, end: line },\n        lang: 'java',\n        hash: this.ctx.hash(`${this.path}:${line}:${expr ?? ''}`),\n      });\n    }\n    return id;\n  }",
    "truncated": false,
    "totalLines": 17,
    "startLine": 520
  },
