  "source": {
    "text": "  private walkLoop(\n    s: PyStmt,\n    procId: string,\n    guardStack: string[],\n    inLoop: boolean,\n    inException: boolean,\n    w: WalkCtx,\n  ): void {\n    const condId = this.condition(w, s.predicate ?? '', s.line, 'LOOP');\n    this.walkBody(s.body ?? [], procId, [...guardStack, condId], 'LOOP', true, inException, w);\n  }",
    "truncated": false,
    "totalLines": 11,
