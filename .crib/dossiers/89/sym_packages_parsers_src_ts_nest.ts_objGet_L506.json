  "source": {
    "text": "function objGet(o: ts.ObjectLiteralExpression, key: string): string | undefined {\n  const v = objRaw(o, key);\n  if (!v) return undefined;\n  if (ts.isStringLiteral(v) || ts.isNumericLiteral(v) || ts.isIdentifier(v)) return v.text;\n  return v.getText();\n}",
