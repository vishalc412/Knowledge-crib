  "source": {
    "text": "    const edgePairs = (rel: string): string[] =>\n      [...soul.iterateEdges(rel as never)]\n        .map((e) => {\n          const s = nodes.find((n) => n.id === e.src)?.qualifiedName ?? e.src;\n          const d = nodes.find((n) => n.id === e.dst)?.qualifiedName ?? e.dst;\n          return `${s} -> ${d}`;\n        })\n        .sort();",
