  "source": {
    "text": "const sig = (soul) => {\n  const nodes = [...soul.iterate('symbol')]\n    .map((n) => `${n.id}|${n.lang ?? ''}|${n.qualifiedName ?? ''}`)\n    .sort()\n    .join(',');\n  const edges = [...soul.iterateEdges()]\n    .map((e) => `${e.id}|${e.src}|${e.dst}|${e.rel}`)\n    .sort()\n    .join(',');\n  return `${nodes}::${edges}`;\n};",
