  "source": {
    "text": "function sumGapCategories(parts: GapCategoryCounts[]): GapCategoryCounts {\n  const out = initGapCategories();\n  for (const part of parts) {\n    for (const category of GAP_CATEGORIES) out[category] += part[category];\n  }\n  return out;\n}",
