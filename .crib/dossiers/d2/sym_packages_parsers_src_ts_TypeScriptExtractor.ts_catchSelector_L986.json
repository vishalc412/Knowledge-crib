  "source": {
    "text": "function catchSelector(cc: ts.CatchClause): string | undefined {\n  const p = cc.variableDeclaration;\n  if (!p || !p.type) return undefined;\n  if (ts.isTypeReferenceNode(p.type)) return p.type.typeName.getText();\n  return undefined;\n}",
