  "source": {
    "text": "  async close() {\n    this.child.stdin.end();\n    await Promise.race([this.exit, new Promise((resolveExit) => setTimeout(resolveExit, 2_000))]);\n    if (!this.child.killed) this.child.kill('SIGTERM');\n  }",
