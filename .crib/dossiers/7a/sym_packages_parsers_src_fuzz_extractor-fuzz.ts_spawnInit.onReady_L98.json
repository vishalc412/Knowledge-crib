  "source": {
    "text": "    const onReady = (msg: WorkerOutMsg) => {\n      if (msg.kind === 'ready') {\n        w.off('message', onReady);\n        resolve(w);\n      } else if (msg.kind === 'error') {\n        w.off('message', onReady);\n        reject(new Error(`worker init failed for ${extractorName}: ${msg.message}`));\n      }\n    };",
