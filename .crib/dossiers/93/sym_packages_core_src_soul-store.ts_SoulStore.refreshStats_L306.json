  "source": {
    "text": "  private refreshStats(now: string): void {\n    let clusters = 0;\n    for (const n of this.nodes.values()) if (n.kind === 'cluster') clusters++;\n    this.manifest.stats = {\n      ...this.manifest.stats,\n      nodes: this.nodes.size,\n      edges: this.edges.size,\n      clusters,\n      lastUpdated: now,\n    };\n  }",
