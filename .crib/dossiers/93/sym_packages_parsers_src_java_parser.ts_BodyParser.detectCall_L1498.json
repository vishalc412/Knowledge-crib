  "source": {
    "text": "  private detectCall(j: number): string[] | null {\n    let k = j;\n    const chain: string[] = [this.t[k]!.value];\n    k++;\n    while (\n      k < this.t.length &&\n      this.t[k]!.type === 'OP' &&\n      this.t[k]!.value === '.' &&\n      this.t[k + 1]?.type === 'NAME'\n    ) {\n      chain.push(this.t[k + 1]!.value);\n      k += 2;\n    }\n    if (k < this.t.length && this.t[k]!.type === 'OP' && this.t[k]!.value === '(') return chain;\n    return null;\n  }",
    "truncated": false,
