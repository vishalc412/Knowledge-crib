  "source": {
    "text": "function bodyNodeIdsOfKind(soul: SoulStore, ids: Set<string>, kind: Node['kind']): string[] {\n  const out: string[] = [];\n  for (const id of ids) {\n    const n = soul.getNode(id);\n    if (n?.kind === kind) out.push(id);\n  }\n  return out;\n}",
