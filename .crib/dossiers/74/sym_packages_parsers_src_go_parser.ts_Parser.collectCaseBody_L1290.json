  "source": {
    "text": "  private collectCaseBody(): GoBodyStmt[] {\n    const stmts: GoBodyStmt[] = [];\n    while (!this.atEnd()) {\n      if (this.isOp('}')) break;\n      if (this.isName('case') || this.isName('default')) break;\n      if (this.isOp(';') || this.isOp(',')) {\n        this.next();\n        continue;\n      }\n      if (this.isOp('{')) {\n        const line = this.peek().line;\n        const blk = this.parseBlock();\n        stmts.push({ kind: 'block', line, endLine: blk.closeLine, text: '', body: blk.stmts });\n        continue;\n      }\n      const tk = this.peek();\n      if (tk.type === 'NAME') {\n        if (tk.value === 'if') {\n          stmts.push(this.parseIf());\n          continue;\n        }\n        if (tk.value === 'for') {\n          stmts.push(this.parseFor());\n          continue;\n        }\n        if (tk.value === 'switch') {\n          stmts.push(this.parseSwitch());\n          continue;\n        }\n        if (tk.value === 'select') {\n          stmts.push(this.parseSelect());\n          continue;\n        }\n        if (tk.value === 'return') {\n          stmts.push(this.parseReturn());\n          continue;\n        }\n        if (tk.value === 'defer') {\n          stmts.push(this.parseDefer());\n          continue;\n        }\n        if (\n          tk.value === 'var' ||\n          tk.value === 'const' ||\n          tk.value === 'type' ||\n          tk.value === 'break' ||\n          tk.value === 'continue' ||\n          tk.value === 'fallthrough' ||\n          tk.value === 'goto'\n        ) {\n          this.skipToSemi();\n          continue;\n        }\n      }\n      const before = this.i;\n      const s = this.parseSimpleStmt();\n      if (s) stmts.push(s);\n      else if (this.i === before && !this.atEnd() && !this.isOp('}')) this.next();\n    }\n    return stmts;\n  }",
    "truncated": false,
    "totalLines": 61,
    "startLine": 1290
  },
