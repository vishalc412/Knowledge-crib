  "source": {
    "text": "function outgoingIndex(soul: SoulStore): Map<string, Edge[]> {\n  const idx = new Map<string, Edge[]>();\n  for (const e of soul.iterateEdges()) {\n    const list = idx.get(e.src);\n    if (list) list.push(e);\n    else idx.set(e.src, [e]);\n  }\n  return idx;\n}",
    "truncated": false,
