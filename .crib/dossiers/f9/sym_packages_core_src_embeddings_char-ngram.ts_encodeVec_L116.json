  "source": {
    "text": "export function encodeVec(v: Vec): Uint8Array {\n  const buf = new ArrayBuffer(v.length * 4);\n  const view = new DataView(buf);\n  for (let i = 0; i < v.length; i++) view.setFloat32(i * 4, v[i] ?? 0, true);\n  return new Uint8Array(buf);\n}",
