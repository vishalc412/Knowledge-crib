  "source": {
    "text": "export function pathFromId(id: string): string | undefined {\n  const colon = id.indexOf(':');\n  if (colon === -1) return undefined;\n  const prefix = id.slice(0, colon);\n  const rest = id.slice(colon + 1);\n  switch (prefix) {\n    case 'file':\n      return rest;\n    case 'sym':\n    case 'doc':\n    case 'media':\n    case 'cursor': {\n      // path is up to the first '#'\n      const hash = rest.indexOf('#');\n      return hash === -1 ? rest : rest.slice(0, hash);\n    }\n    case 'expl':\n    case 'stmt':\n    case 'cond':\n    case 'exc':\n    case 'raise':\n    case 'assign':\n    case 'case': {\n      // path is up to the '@L' line suffix\n      const at = rest.lastIndexOf('@L');\n      return at === -1 ? rest : rest.slice(0, at);\n    }\n    default:\n      // c: (cluster), table:, col: carry no fs path\n      return undefined;\n  }\n}",
    "truncated": false,
    "totalLines": 32,
    "startLine": 16
  },
