  "source": {
    "text": "function fieldElementType(t: string | undefined): string | undefined {\n  if (!t) return undefined;\n  let s = t.trim();\n  for (;;) {\n    const m = s.match(/^(?:Promise|Array|ReadonlyArray)<(.+)>$/);\n    if (m) {\n      s = m[1]!.trim();\n      continue;\n    }\n    if (/\\[\\s*\\]$/.test(s)) {\n      s = s.replace(/\\[\\s*\\]$/, '').trim();\n      continue;\n    }\n    break;\n  }\n  return s.length > 0 ? s : undefined;\n}",
    "truncated": false,
    "totalLines": 17,
