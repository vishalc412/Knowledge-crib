  "source": {
    "text": "  resolveTable(ref: string): string | undefined {\n    const r = ref.toLowerCase();\n    const q = this.qualified.get(r);\n    if (q) return q;\n    const last = r.split('.').pop() ?? r;\n    const byName = this.byName.get(last);\n    return byName?.[0];\n  }",
