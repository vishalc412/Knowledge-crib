  "source": {
    "text": "export function serializeChunk(map: Map<string, ChunkRecord>): string {\n  const lines = [...map.entries()]\n    .sort((a, b) => (a[0] < b[0] ? -1 : a[0] > b[0] ? 1 : 0))\n    .map(([, rec]) => JSON.stringify(rec));\n  return lines.length === 0 ? '' : `${lines.join('\\n')}\\n`;\n}",
    "truncated": false,
