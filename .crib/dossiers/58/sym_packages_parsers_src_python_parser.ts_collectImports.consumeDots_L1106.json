  "source": {
    "text": "  const consumeDots = (k: number): { j: number; relative: number } => {\n    let relative = 0;\n    let j = k;\n    while (isOp(j, '.')) {\n      relative++;\n      j++;\n    }\n    return { j, relative };\n  };",
