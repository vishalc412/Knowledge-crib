  "source": {
    "text": "  private consumeColon(): boolean {\n    while (this.is('NEWLINE') || this.is('NL')) this.next();\n    if (this.is('OP') && this.peek().value === ':') {\n      this.next();\n      return true;\n    }\n    return false;\n  }",
