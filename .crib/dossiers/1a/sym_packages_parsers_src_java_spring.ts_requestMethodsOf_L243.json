  "source": {
    "text": "function requestMethodsOf(s?: string): string[] | undefined {\n  if (!s) return undefined;\n  const out: string[] = [];\n  const re = /RequestMethod\\.([A-Z]+)/g;\n  let m: RegExpExecArray | null;\n  while ((m = re.exec(s)) !== null) out.push(m[1]!);\n  return out.length > 0 ? out : undefined;\n}",
