  "source": {
    "text": "function isDefKeywordAt(tokens: Token[], idx: number): boolean {\n  const tk = tokens[idx];\n  if (!tk || tk.type !== 'NAME') return false;\n  // tolerate `async def`: the NAME before `def` is `async` — so also check idx-1.\n  return tk.value === 'def' || tk.value === 'class';\n}",
    "truncated": false,
