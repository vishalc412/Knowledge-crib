  "source": {
    "text": "  private reconstruct(\n    from: string,\n    to: string,\n    prev: Map<string, { node: string; edge: Edge }>,\n  ): PathResult {\n    const path: string[] = [to];\n    const edges: Edge[] = [];\n    let cur = to;\n    while (cur !== from) {\n      const step = prev.get(cur);\n      if (!step) break;\n      edges.push(step.edge);\n      path.push(step.node);\n      cur = step.node;\n    }\n    path.reverse();\n    edges.reverse();\n    return { found: true, path, edges };\n  }",
    "truncated": false,
    "totalLines": 19,
    "startLine": 173
  },
