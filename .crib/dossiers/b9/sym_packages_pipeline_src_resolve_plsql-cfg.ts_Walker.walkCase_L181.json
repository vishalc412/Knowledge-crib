  "source": {
    "text": "  private walkCase(s: CaseStmt, procId: string, frames: GuardFrame[]): void {\n    for (const branch of s.branches) {\n      const caseBranchId = idFor({ kind: 'case-branch', file: this.path, line: branch.span.start });\n      const frame: GuardFrame = {\n        condId: caseBranchId,\n        branch: branch.label,\n        loop: false,\n        exception: false,\n      };\n      this.walkBlock(branch.body, procId, [...frames, frame]);\n    }\n  }",
    "truncated": false,
    "totalLines": 12,
    "startLine": 181
  },
