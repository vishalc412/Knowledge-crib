  "source": {
    "text": "  private readHolder(): number {\n    try {\n      const text = readFileSync(this.path, 'utf8').trim();\n      const pid = Number.parseInt(text, 10);\n      return Number.isInteger(pid) ? pid : 0;\n    } catch {\n      return 0;\n    }\n  }",
