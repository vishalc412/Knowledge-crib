  "source": {
    "text": "  private parseBlockBody(): RustStmt[] {\n    if (!this.isOp('{')) {\n      // malformed body (no brace) — skip to `;`/`}` and degrade to an empty body (lossy, no throw)\n      this.skipToSemiOrClose();\n      return [];\n    }\n    this.next(); // {\n    const res = this.parseStmtBlock();\n    return res.stmts;\n  }",
