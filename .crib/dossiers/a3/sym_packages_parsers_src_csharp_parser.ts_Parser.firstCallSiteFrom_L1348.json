  "source": {
    "text": "  private firstCallSiteFrom(from: number): CsharpCallSite | undefined {\n    const slice = this.t.slice(from, this.i);\n    if (slice.length === 0) return undefined;\n    const calls = collectCallSites(slice, new Set<number>());\n    return calls[0];\n  }",
