  "source": {
    "text": "export function clampExpr(s: string, max = EXPR_MAX_CHARS): { expr: string; truncated: boolean } {\n  if (s.length <= max) return { expr: s, truncated: false };\n  return { expr: s.slice(0, max), truncated: true };\n}",
