  "source": {
    "text": "function collectHooks(body: ts.Node | undefined): string[] {\n  if (!body) return [];\n  const out: string[] = [];\n  const visit = (node: ts.Node): void => {\n    if (ts.isCallExpression(node)) {\n      const h = hookCallName(node);\n      if (h) out.push(h);\n    }\n    ts.forEachChild(node, visit);\n  };\n  visit(body);\n  return out;\n}",
