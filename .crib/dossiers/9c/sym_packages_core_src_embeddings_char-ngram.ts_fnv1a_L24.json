  "source": {
    "text": "function fnv1a(s: string): number {\n  let h = 0x811c9dc5;\n  for (let i = 0; i < s.length; i++) {\n    h ^= s.charCodeAt(i);\n    // h *= 16777619, kept in uint32 via Math.imul for sign-stable behavior.\n    h = Math.imul(h, 0x01000193);\n  }\n  // force unsigned 32-bit\n  return h >>> 0;\n}",
    "truncated": false,
