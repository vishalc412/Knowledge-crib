  "source": {
    "text": "  private parseBlock(): { stmts: GoBodyStmt[]; closeLine: number } {\n    if (!this.isOp('{')) return { stmts: [], closeLine: this.peek().line };\n    this.next(); // {\n    const res = this.parseStmts(false);\n    return { stmts: res.stmts, closeLine: res.closeLine };\n  }",
