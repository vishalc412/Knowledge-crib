  "source": {
    "text": "  const collectFromTables = (): void => {\n    for (let i = 0; i < toks.length; i++) {\n      const t = tokAt(toks, i);\n      if (!t || t.type !== 'word') continue;\n      if (t.text === 'from' || t.text === 'join' || t.text === 'using')\n        pushFromTable(toks, i, tables);\n    }\n  };",
