  "source": {
    "text": "function firstInjectToken(dec: ts.Decorator): string | undefined {\n  const a = decArgs(dec)[0];\n  if (!a) return undefined;\n  if (ts.isStringLiteral(a)) return a.text;\n  if (ts.isIdentifier(a)) return a.text;\n  return a.getText();\n}",
