  "source": {
    "text": "function writeJsonlAtomic(path: string, values: unknown[]): void {\n  const tmp = `${path}.tmp`;\n  mkdirSync(dirname(path), { recursive: true });\n  writeFileSync(\n    tmp,\n    values.map((v) => JSON.stringify(v)).join('\\n') + (values.length ? '\\n' : ''),\n    'utf8',\n  );\n  renameSync(tmp, path);\n}",
