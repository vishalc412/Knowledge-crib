  "source": {
    "text": "  private parseStmtList(): CsharpStmt[] {\n    const out: CsharpStmt[] = [];\n    while (!this.atEnd() && !this.isOp('}')) {\n      const before = this.i;\n      const s = this.parseStmt();\n      if (s) out.push(s);\n      else if (this.i === before && !this.atEnd()) this.next(); // progress guard\n    }\n    return out;\n  }",
    "truncated": false,
    "totalLines": 10,
    "startLine": 1018
  },
