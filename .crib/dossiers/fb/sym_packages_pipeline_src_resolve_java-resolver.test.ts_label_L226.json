  "source": {
    "text": "function label(soul: SoulStore, id: string): string {\n  const n: Node | undefined = [...soul.iterate()].find((x) => x.id === id);\n  if (!n) return id;\n  switch (n.kind) {\n    case 'symbol':\n      return `sym:${n.qualifiedName ?? n.name}`;\n    case 'file':\n      return `file:${shortFile(n.file)}`;\n    default:\n      return n.kind;\n  }\n}",
    "truncated": false,
    "totalLines": 12,
