  "source": {
    "text": "  private skipStringInHole(): void {\n    // We are at a `\"`. Count the opening quote run (advancing pos) to dispatch raw vs regular.\n    let quoteRun = 0;\n    while (this.peek() === '\"') {\n      quoteRun++;\n      this.advance();\n    }\n    if (quoteRun >= 3) {\n      const need = quoteRun;\n      while (this.pos < this.src.length) {\n        if (this.peek() === '\"') {\n          let run = 0;\n          while (this.peek() === '\"') {\n            run++;\n            this.advance();\n          }\n          if (run >= need) return;\n          continue; // not enough to close — accept as body content (already consumed)\n        }\n        this.advance();\n      }\n      return;\n    }\n    if (quoteRun === 2) return; // empty string, already consumed\n    // quoteRun === 1: regular string with `\\` escapes; opening `\"` already consumed.\n    while (this.pos < this.src.length) {\n      const c = this.peek();\n      if (c === '\\\\') {\n        this.advance();\n        if (this.pos < this.src.length) this.advance();\n        continue;\n      }\n      if (c === '\\n' || c === '\\r') break;\n      this.advance();\n      if (c === '\"') break;\n    }\n  }",
    "truncated": false,
