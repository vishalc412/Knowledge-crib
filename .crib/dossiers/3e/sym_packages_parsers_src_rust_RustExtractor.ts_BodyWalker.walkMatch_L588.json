  "source": {
    "text": "  private walkMatch(\n    s: RustStmt & { kind: 'match' },\n    procId: string,\n    guardStack: GuardFrame[],\n    inLoop: boolean,\n    inException: boolean,\n    sites: GuardedCallSite[],\n  ): void {\n    for (const arm of s.arms) {\n      const condId = this.caseBranch(arm.pat || '_', arm.line);\n      this.walkBody(\n        arm.body,\n        procId,\n        [...guardStack, { condId, branch: 'CASE' }],\n        inLoop,\n        inException,\n        sites,\n      );\n    }\n  }",
    "truncated": false,
