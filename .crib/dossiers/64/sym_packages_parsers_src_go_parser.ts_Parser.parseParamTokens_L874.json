  "source": {
    "text": "  private parseParamTokens(tokens: Token[], openIdx: number): string[] {\n    const params: string[] = [];\n    let i = openIdx + 1;\n    let pdepth = 1;\n    let bdepth = 0;\n    let brdepth = 0;\n    let cur: Token[] = [];\n    while (i < tokens.length && pdepth > 0) {\n      const tk = tokens[i]!;\n      if (tk.type === 'OP') {\n        if (tk.value === '(') {\n          pdepth++;\n        } else if (tk.value === ')') {\n          pdepth--;\n          if (pdepth === 0) {\n            this.collectParamName(cur, params);\n            break;\n          }\n        } else if (tk.value === '[') {\n          bdepth++;\n        } else if (tk.value === ']') {\n          bdepth = Math.max(0, bdepth - 1);\n        } else if (tk.value === '{') {\n          brdepth++;\n        } else if (tk.value === '}') {\n          brdepth = Math.max(0, brdepth - 1);\n        } else if (tk.value === ',' && pdepth === 1 && bdepth === 0 && brdepth === 0) {\n          this.collectParamName(cur, params);\n          cur = [];\n          i++;\n          continue;\n        }\n      }\n      if (pdepth === 1 && bdepth === 0 && brdepth === 0) cur.push(tk);\n      i++;\n    }\n    return params;\n  }",
    "truncated": false,
    "totalLines": 38,
    "startLine": 874
  },
