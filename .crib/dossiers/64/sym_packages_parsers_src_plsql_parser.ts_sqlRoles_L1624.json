  "source": {
    "text": "export function sqlRoles(verb: string, tables: string[]): { reads: string[]; writes: string[] } {\n  switch (verb) {\n    case 'select':\n      return { reads: [...tables], writes: [] };\n    case 'insert':\n    case 'merge':\n      return { writes: tables.slice(0, 1), reads: tables.slice(1) };\n    case 'update':\n      return { writes: tables.slice(0, 1), reads: tables.slice(1) };\n    case 'delete':\n      return { writes: tables.slice(0, 1), reads: [] };\n    default:\n      return { reads: [], writes: [] };\n  }\n}",
    "truncated": false,
    "totalLines": 15,
    "startLine": 1624
  },
