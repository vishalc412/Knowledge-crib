  "source": {
    "text": "    public String decide(int status) {\n        int count;\n        count = status + 1;\n        try {\n            if (status < 0) {\n                throw new IllegalStateException(\"negative status\");\n            }\n            switch (status) {\n                case 0:\n                    return \"zero\";\n                case 1:\n                    return \"one\";\n                default:\n                    return \"other\";\n            }\n        } catch (IllegalStateException ex) {\n            return \"caught\";\n        }\n    }",
