  "source": {
    "text": "  private isIdentPart(c: string): boolean {\n    return (\n      (c >= 'a' && c <= 'z') ||\n      (c >= 'A' && c <= 'Z') ||\n      (c >= '0' && c <= '9') ||\n      c === '_' ||\n      c.charCodeAt(0) > 127\n    );\n  }",
