  "source": {
    "text": "  PROCEDURE process_claim(p_id NUMBER) IS\n    v_amt NUMBER;\n  BEGIN\n    SELECT amount INTO v_amt FROM claims WHERE id = p_id;\n    IF v_amt > 1000 THEN\n      UPDATE claims SET status = 'PAID' WHERE id = p_id;\n      audit_pkg.log_event('claim paid');\n    END IF;\n  END process_claim;\nEND claim_pkg;",
    "truncated": false,
