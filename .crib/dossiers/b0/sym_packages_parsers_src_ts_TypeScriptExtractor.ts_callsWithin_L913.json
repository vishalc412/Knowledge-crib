  "source": {
    "text": "function callsWithin(stmt: ts.Statement): ts.CallExpression[] {\n  const out: ts.CallExpression[] = [];\n  const walk = (n: ts.Node): void => {\n    if (ts.isCallExpression(n)) out.push(n);\n    ts.forEachChild(n, walk);\n  };\n  ts.forEachChild(stmt, walk);\n  return out;\n}",
