  "source": {
    "text": "function stripQuotes(v: string): string {\n  if (v.length >= 2 && v[0] === '\"' && v[v.length - 1] === '\"') return v.slice(1, -1);\n  if (v.length >= 2 && v[0] === '`' && v[v.length - 1] === '`') return v.slice(1, -1);\n  return v;\n}",
