  "source": {
    "text": "  private readTypePath(): string {\n    let simple = '';\n    if (this.isNameToken()) {\n      simple = this.peek().value;\n      this.next();\n      while (this.isOp('::') && this.peek1().type === 'NAME') {\n        this.next(); // ::\n        simple = this.peek().value;\n        this.next();\n      }\n      if (this.isOp('<')) this.skipGenericAngle();\n    }\n    return simple;\n  }",
    "truncated": false,
    "totalLines": 14,
    "startLine": 732
  },
