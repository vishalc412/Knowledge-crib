    "text": "  private writeArtifact(artifact: LlmArtifact): string {\n    const path = artifactPath(\n      this.artifactsRoot(),\n      artifact.layer,\n      artifact.targetId,\n      artifact.nodeHash,\n    );\n    writeJsonAtomic(path, artifact);\n    return path;\n  }",
