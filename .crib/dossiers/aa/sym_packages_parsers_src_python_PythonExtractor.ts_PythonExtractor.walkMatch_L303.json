  "source": {
    "text": "  private walkMatch(\n    s: PyStmt,\n    procId: string,\n    guardStack: string[],\n    inLoop: boolean,\n    inException: boolean,\n    w: WalkCtx,\n  ): void {\n    for (const c of s.cases ?? []) {\n      const pat = c.predicate ?? '';\n      const cbId = this.caseBranch(w, pat, c.line);\n      this.walkBody(c.body, procId, [...guardStack, cbId], 'CASE', inLoop, inException, w);\n    }\n  }",
