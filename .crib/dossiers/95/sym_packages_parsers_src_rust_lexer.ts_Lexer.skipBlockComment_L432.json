  "source": {
    "text": "  private skipBlockComment(): void {\n    this.advance(); // /\n    this.advance(); // *\n    let depth = 1;\n    while (this.pos < this.src.length && depth > 0) {\n      if (this.peek() === '/' && this.peek(1) === '*') {\n        this.advance();\n        this.advance();\n        depth++;\n        continue;\n      }\n      if (this.peek() === '*' && this.peek(1) === '/') {\n        this.advance();\n        this.advance();\n        depth--;\n        continue;\n      }\n      this.advance();\n    }\n  }",
    "truncated": false,
    "totalLines": 20,
    "startLine": 432
  },
