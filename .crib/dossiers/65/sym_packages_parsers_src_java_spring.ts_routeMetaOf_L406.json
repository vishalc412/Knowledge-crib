  "source": {
    "text": "function routeMetaOf(m: JavaDef): Record<string, unknown> {\n  const meta: Record<string, unknown> = {};\n  const params = routeParamsOf(m);\n  if (params.length) meta.params = params;\n  const sec = securityOf(m);\n  if (sec) meta.security = sec;\n  return meta;\n}",
