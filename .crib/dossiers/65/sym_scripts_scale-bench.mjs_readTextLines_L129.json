  "source": {
    "text": "function readTextLines(p) {\n  try {\n    const buf = readFileSync(p);\n    let n = 0;\n    for (let i = 0; i < buf.length; i++) if (buf[i] === 0x0a) n++;\n    return buf.length > 0 && buf[buf.length - 1] !== 0x0a ? n + 1 : n; // trailing line w/o newline\n  } catch {\n    return 0;\n  }\n}",
