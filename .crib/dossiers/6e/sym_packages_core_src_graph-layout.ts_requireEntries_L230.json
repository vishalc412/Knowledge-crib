  "source": {
    "text": "function requireEntries(dir: string): Array<{ path: string; directory: boolean }> {\n  return readdirSync(dir).map((name) => {\n    const path = join(dir, name);\n    return { path, directory: statSync(path).isDirectory() };\n  });\n}",
