  "source": {
    "text": "export function isGitRepo(root: string): boolean {\n  try {\n    return (\n      execFileSync('git', ['-C', root, 'rev-parse', '--is-inside-work-tree'], {\n        encoding: 'utf8',\n        stdio: ['ignore', 'pipe', 'ignore'],\n      }).trim() === 'true'\n    );\n  } catch {\n    return false;\n  }\n}",
