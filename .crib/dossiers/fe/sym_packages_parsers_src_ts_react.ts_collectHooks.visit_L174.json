  "source": {
    "text": "  const visit = (node: ts.Node): void => {\n    if (ts.isCallExpression(node)) {\n      const h = hookCallName(node);\n      if (h) out.push(h);\n    }\n    ts.forEachChild(node, visit);\n  };",
