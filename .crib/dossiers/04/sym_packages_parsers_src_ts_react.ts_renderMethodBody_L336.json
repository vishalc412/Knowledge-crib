    "text": "function renderMethodBody(cls: ts.ClassDeclaration): ts.Node | undefined {\n  for (const m of cls.members) {\n    if (ts.isMethodDeclaration(m) && ts.isIdentifier(m.name) && m.name.text === 'render') {\n      return m.body;\n    }\n  }\n  return undefined;\n}",
