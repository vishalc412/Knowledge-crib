    "text": "  private insertEdge(edge: Edge): void {\n    this.db\n      .prepare(\n        'INSERT OR REPLACE INTO edges (id, src, dst, rel, provenance, confidence, json) VALUES (?, ?, ?, ?, ?, ?, ?)',\n      )\n      .run(\n        edge.id,\n        edge.src,\n        edge.dst,\n        edge.rel,\n        edge.provenance,\n        edge.confidence,\n        JSON.stringify(edge),\n      );\n  }",
