  "source": {
    "text": "  function dcNameFromPath(pathname) {\n    let p = pathname || \"\";\n    try {\n      p = decodeURIComponent(p);\n    } catch {\n    }\n    const base = p.split(\"/\").pop() || \"Root\";\n    return base.replace(/\\.dc\\.html$/, \"\").replace(/\\.html?$/, \"\") || \"Root\";\n  }",
