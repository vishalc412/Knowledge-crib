  "source": {
    "text": "export async function withCribLockAsync<T>(\n  opts: CribLockOptions,\n  fn: () => T | Promise<T>,\n): Promise<T> {\n  const lock = new CribLock(opts);\n  lock.acquire();\n  try {\n    return await fn();\n  } finally {\n    lock.release();\n  }\n}",
    "truncated": false,
    "totalLines": 12,
