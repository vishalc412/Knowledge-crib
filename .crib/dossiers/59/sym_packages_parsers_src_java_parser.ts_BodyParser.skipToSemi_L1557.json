  "source": {
    "text": "  private skipToSemi(): void {\n    let p = 0;\n    let b = 0;\n    let br = 0;\n    while (this.i < this.end) {\n      const tk = this.peek();\n      if (tk.type === 'EOF') return;\n      if (p === 0 && b === 0 && br === 0 && this.isOp(';')) {\n        this.next();\n        return;\n      }\n      if (p === 0 && b === 0 && br === 0 && this.isOp('}')) return;\n      if (tk.type === 'OP') {\n        if (tk.value === '(') p++;\n        else if (tk.value === ')') p = Math.max(0, p - 1);\n        else if (tk.value === '[') br++;\n        else if (tk.value === ']') br = Math.max(0, br - 1);\n        else if (tk.value === '{') b++;\n        else if (tk.value === '}') b = Math.max(0, b - 1);\n      }\n      this.next();\n    }\n  }",
    "truncated": false,
    "totalLines": 23,
    "startLine": 1557
