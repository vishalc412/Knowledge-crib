  "source": {
    "text": "function stripBlockLine(line: string): string {\n  let t = line;\n  t = t.replace(/^\\/\\*+[!*]?/, '');\n  t = t.replace(/\\*+\\/$/, '');\n  t = t.replace(/^\\s*\\*\\s?/, '');\n  return t.trim();\n}",
