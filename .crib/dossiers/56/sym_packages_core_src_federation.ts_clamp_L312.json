  "source": {
    "text": "function clamp(v: number | undefined, def: number, max: number): number {\n  if (v === undefined || !Number.isFinite(v)) return def;\n  if (v < 1) return 1;\n  if (v > max) return max;\n  return Math.floor(v);\n}",
