  "source": {
    "text": "  private walkFor(\n    s: GoForStmt,\n    proc: ProcCtx,\n    guardStack: string[],\n    inLoop: boolean,\n    inException: boolean,\n  ): void {\n    const condId = this.condition(s.predicate, s.forLine, 'LOOP');\n    this.walkBody(s.body, proc, [...guardStack, condId], 'LOOP', true, inException);\n  }",
    "truncated": false,
