  "source": {
    "text": "function resolveEndpoint(\n  endpoint: string,\n  targetId: string,\n  localIds: Map<string, string>,\n): string {\n  if (localIds.has(endpoint)) return localIds.get(endpoint)!;\n  if (endpoint.startsWith('llm:') || endpoint.includes(':')) return endpoint;\n  return `llm:${targetId}#${endpoint}`;\n}",
