  "source": {
    "text": "  private findFirstString(start: number, end: number): string | undefined {\n    for (let k = start; k < end; k++) {\n      const tk = this.t[k]!;\n      if (tk.type === 'STRING') {\n        const v = tk.value;\n        // the lexer emits string tokens whose value starts and ends with `\"` (raw bodies too)\n        if (v.length >= 2 && v.startsWith('\"') && v.endsWith('\"')) return v.slice(1, -1);\n        return v;\n      }\n    }\n    return undefined;\n  }",
    "truncated": false,
    "totalLines": 12,
    "startLine": 1345
  },
