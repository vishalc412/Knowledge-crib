  "source": {
    "text": "  private parseMod(startLine: number, attributes: string[], modifiers: string[]): RustDef | null {\n    this.next(); // mod\n    if (!this.isNameToken()) return null;\n    const name = this.peek().value;\n    this.next();\n    let body: RustDef[] = [];\n    let endLine = startLine;\n    if (this.isOp('{')) {\n      this.next();\n      const res = this.parseDecls(false);\n      body = res.defs;\n      endLine = res.closeLine || this.peek().line;\n    } else if (this.isOp(';')) {\n      this.next();\n      endLine = this.peek().line; // `mod foo;` (file-module declaration)\n    }\n    endLine = Math.max(endLine, ...body.map((b) => b.endLine), startLine);\n    return {\n      kind: 'mod',\n      name,\n      startLine,\n      endLine,\n      modifiers,\n      attributes,\n      bases: [],\n      typeParams: [],\n      params: [],\n      hasSelf: false,\n      body,\n    };\n  }",
    "truncated": false,
    "totalLines": 31,
    "startLine": 363
  },
