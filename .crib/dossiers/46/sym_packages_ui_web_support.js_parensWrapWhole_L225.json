  "source": {
    "text": "  function parensWrapWhole(expr) {\n    let depth = 0;\n    for (let i = 0; i < expr.length - 1; i++) {\n      if (expr[i] === \"(\") depth++;\n      else if (expr[i] === \")\") {\n        depth--;\n        if (depth === 0) return false;\n      }\n    }\n    return true;\n  }",
