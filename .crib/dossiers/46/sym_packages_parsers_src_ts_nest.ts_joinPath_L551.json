  "source": {
    "text": "function joinPath(base: string, sub: string): string {\n  const a = base.replace(/\\/+$/, '');\n  const b = sub.replace(/^\\/+/, '');\n  const joined = b ? `${a}/${b}` : a;\n  const out = joined.startsWith('/') ? joined : `/${joined}`;\n  return out.replace(/\\/{2,}/g, '/') || '/';\n}",
