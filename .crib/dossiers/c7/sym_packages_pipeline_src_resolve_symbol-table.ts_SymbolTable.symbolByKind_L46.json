  "source": {
    "text": "  symbolByKind(file: string, name: string, kinds: ReadonlySet<string>): Node | undefined {\n    const syms = this.byFile.get(file);\n    if (!syms) return undefined;\n    for (const s of syms) {\n      if (s.name === name && s.type !== undefined && kinds.has(s.type)) return s;\n    }\n    return undefined;\n  }",
