  "source": {
    "text": "  private close(): void {\n    // flush a trailing NEWLINE if the last token isn't one\n    const last = this.out[this.out.length - 1];\n    if (last && last.type !== 'NEWLINE' && last.type !== 'NL') this.emit('NEWLINE', '\\n');\n    while (this.indents.length > 1) {\n      this.indents.pop();\n      this.emit('DEDENT', '');\n    }\n    this.emit('ENDMARKER', '');\n  }",
    "truncated": false,
    "totalLines": 10,
