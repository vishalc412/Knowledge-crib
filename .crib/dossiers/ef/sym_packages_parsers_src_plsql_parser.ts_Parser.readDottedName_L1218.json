  "source": {
    "text": "  private readDottedName(): string | null {\n    if (this.at().type !== 'word') return null;\n    const parts: string[] = [this.next().raw];\n    while (this.isPunct('.')) {\n      this.pos++;\n      if (this.at().type === 'word') parts.push(this.next().raw);\n      else break;\n    }\n    return parts.join('.');\n  }",
