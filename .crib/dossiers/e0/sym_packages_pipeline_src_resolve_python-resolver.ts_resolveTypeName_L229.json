  "source": {
    "text": "function resolveTypeName(\n  name: string,\n  file: string,\n  imports: Map<string, NameBinding>,\n  table: SymbolTable,\n): string | undefined {\n  const b = imports.get(name);\n  if (b) return table.topLevelSymbol(b.file, b.name)?.id;\n  return table.topLevelSymbol(file, name)?.id;\n}",
