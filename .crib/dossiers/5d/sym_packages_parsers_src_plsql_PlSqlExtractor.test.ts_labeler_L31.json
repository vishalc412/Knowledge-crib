  "source": {
    "text": "function labeler(r: ExtractResult): (id: string) => string {\n  return (id: string): string => {\n    const n = r.nodes.find((x) => x.id === id);\n    if (!n) return id;\n    switch (n.kind) {\n      case 'symbol':\n        return n.qualifiedName ?? n.name ?? id;\n      case 'table':\n        return `table:${n.name}`;\n      case 'column':\n        return `col:${n.table}.${n.name}`;\n      case 'statement':\n        return `stmt:L${n.span?.start}:${n.sqlKind ?? n.type}`;\n      case 'condition':\n        return `cond:L${n.span?.start}:${n.branch}`;\n      default:\n        return n.kind;\n    }\n  };\n}",
    "truncated": false,
    "totalLines": 20,
    "startLine": 31
  },
