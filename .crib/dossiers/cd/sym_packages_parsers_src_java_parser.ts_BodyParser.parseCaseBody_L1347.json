  "source": {
    "text": "  private parseCaseBody(closeIdx: number): JavaStmt[] {\n    const out: JavaStmt[] = [];\n    while (this.i < closeIdx) {\n      const tk = this.peek();\n      if (this.isOp('}')) break;\n      if (\n        (tk.type === 'NAME' && (tk.value === 'case' || tk.value === 'default')) ||\n        this.isOp('{')\n      ) {\n        if (this.isOp('{')) {\n          this.skipBraces();\n          continue;\n        }\n        break;\n      }\n      if (this.isOp(';') || this.isOp(',')) {\n        this.next();\n        continue;\n      }\n      const before = this.i;\n      const s = this.parseStmt();\n      if (s) out.push(s);\n      else if (this.i === before) this.next();\n    }\n    return out;\n  }",
    "truncated": false,
    "totalLines": 26,
    "startLine": 1347
  },
