  "source": {
    "text": "  private scanRegularStringBody(sl: number, sc: number): void {\n    let value = '\"';\n    while (this.pos < this.src.length) {\n      const c = this.peek();\n      if (c === '\\\\') {\n        value += c;\n        this.advance();\n        if (this.pos < this.src.length) {\n          value += this.peek();\n          this.advance();\n        }\n        continue;\n      }\n      if (c === '\\n' || c === '\\r') break; // unterminated — tolerate\n      value += c;\n      this.advance();\n      if (c === '\"') break;\n    }\n    this.emit('STRING', value, sl, sc);\n  }",
    "truncated": false,
    "totalLines": 20,
    "startLine": 329
  },
