  "source": {
    "text": "  private skipToSemicolon(): void {\n    let depth = 0;\n    while (this.at().type !== 'eof') {\n      if (this.isPunct('(')) depth++;\n      else if (this.isPunct(')')) depth = Math.max(0, depth - 1);\n      else if (this.isPunct(';') && depth === 0) {\n        this.pos++;\n        return;\n      }\n      this.pos++;\n    }\n  }",
    "truncated": false,
    "totalLines": 12,
    "startLine": 1097
  },
