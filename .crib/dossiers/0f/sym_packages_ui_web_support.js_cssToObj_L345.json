  "source": {
    "text": "  function cssToObj(css) {\n    const o = {};\n    for (const decl of css.split(\";\")) {\n      const i = decl.indexOf(\":\");\n      if (i < 0) continue;\n      const prop = decl.slice(0, i).trim();\n      o[prop.startsWith(\"--\") ? prop : kebabToCamel(prop)] = decl.slice(i + 1).trim();\n    }\n    return o;\n  }",
    "truncated": false,
    "totalLines": 10,
