  "source": {
    "text": "export function installerCommand(bundleDir, platform = process.platform) {\n  if (platform === 'win32') {\n    return {\n      command: 'powershell.exe',\n      args: [\n        '-NoProfile',\n        '-NonInteractive',\n        '-ExecutionPolicy',\n        'Bypass',\n        '-File',\n        path.win32.join(bundleDir, 'install-windows.ps1'),\n      ],\n    };\n  }\n\n  return { command: 'sh', args: [path.posix.join(bundleDir, 'install-macos.sh')] };\n}",
