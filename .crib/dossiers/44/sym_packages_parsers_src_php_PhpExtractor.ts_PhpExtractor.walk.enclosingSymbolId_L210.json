  "source": {
    "text": "    const enclosingSymbolId = (line: number): string | undefined => {\n      let best: LocalSymbol | undefined;\n      for (const s of symbols) {\n        if (s.startLine <= line && line <= s.endLine) {\n          if (!best || s.startLine > best.startLine) best = s;\n        }\n      }\n      return best?.node.id;\n    };",
    "truncated": false,
