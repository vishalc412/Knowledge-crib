  "source": {
    "text": "function mergeEvidence(x?: Evidence, y?: Evidence): Evidence | undefined {\n  if (!x) return y;\n  if (!y) return x;\n  const merged: Evidence = { ...x };\n  for (const [k, v] of Object.entries(y)) {\n    if (merged[k] === undefined) merged[k] = v;\n  }\n  return merged;\n}",
