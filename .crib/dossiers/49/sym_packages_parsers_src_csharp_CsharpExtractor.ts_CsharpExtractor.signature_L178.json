  "source": {
    "text": "  private signature(d: CsharpDef): string {\n    switch (d.kind) {\n      case 'namespace':\n        return `namespace ${d.name}`;\n      case 'class':\n        return `class ${d.name}`;\n      case 'interface':\n        return `interface ${d.name}`;\n      case 'struct':\n        return `struct ${d.name}`;\n      case 'record':\n        return `record ${d.name}(${d.params.join(', ')})`;\n      case 'enum':\n        return `enum ${d.name}`;\n      case 'delegate':\n        return `delegate ${d.name}(${d.params.join(', ')})`;\n      case 'property':\n        return d.name;\n      case 'indexer':\n        return `this[${d.params.join(', ')}]`;\n      case 'operator':\n        return d.name;\n      case 'method':\n      case 'constructor':\n        return `${d.name}(${d.params.join(', ')})`;\n    }\n  }",
    "truncated": false,
    "totalLines": 27,
    "startLine": 178
  },
