  "source": {
    "text": "  private parsePathSum(): string[] {\n    const out: string[] = [];\n    while (!this.atEnd()) {\n      const path = this.readTypePath();\n      if (path) out.push(path);\n      if (this.isOp('+')) {\n        this.next();\n        continue;\n      }\n      break;\n    }\n    return out;\n  }",
