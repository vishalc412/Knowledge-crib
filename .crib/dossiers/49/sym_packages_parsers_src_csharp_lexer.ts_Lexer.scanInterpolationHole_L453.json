  "source": {
    "text": "  private scanInterpolationHole(): string {\n    const start = this.pos;\n    this.advance(); // {\n    let depth = 1;\n    while (this.pos < this.src.length && depth > 0) {\n      const c = this.peek();\n      if (c === '\"') {\n        // an interpolation expression may contain a string literal — skip it whole.\n        this.skipStringInHole();\n        continue;\n      }\n      if (c === '{') {\n        depth++;\n        this.advance();\n        continue;\n      }\n      if (c === '}') {\n        depth--;\n        this.advance();\n        continue;\n      }\n      this.advance();\n    }\n    return this.src.slice(start, this.pos);\n  }",
    "truncated": false,
    "totalLines": 25,
    "startLine": 453
  },
