  "source": {
    "text": "function raceBudget(w: Worker, idx: number, text: string, budgetMs: number): Promise<SlotResult> {\n  return new Promise((resolve, reject) => {\n    let settled = false;\n    const timer = setTimeout(() => {\n      if (settled) return;\n      settled = true;\n      w.off('message', onMsg);\n      reject(new Error('hang'));\n    }, budgetMs);\n    const onMsg = (msg: WorkerOutMsg) => {\n      if (msg.kind === 'result' && msg.idx === idx) {\n        if (settled) return;\n        settled = true;\n        clearTimeout(timer);\n        w.off('message', onMsg);\n        resolve({ idx, outcome: msg.outcome, reason: msg.reason });\n      }\n    };\n    w.on('message', onMsg);\n    w.postMessage({ kind: 'extract', idx, text });\n  });\n}",
    "truncated": false,
    "totalLines": 22,
    "startLine": 114
  },
