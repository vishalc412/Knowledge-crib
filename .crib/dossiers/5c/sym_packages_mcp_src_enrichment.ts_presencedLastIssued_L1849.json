  "source": {
    "text": "function presencedLastIssued(v: unknown): v is Record<string, { batchId: string }> {\n  if (!isRecord(v)) return false;\n  for (const entry of Object.values(v)) {\n    if (!isRecord(entry) || typeof entry.batchId !== 'string') return false;\n  }\n  return true;\n}",
