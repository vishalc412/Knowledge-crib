  "source": {
    "text": "function emitInject(\n  consumerId: string,\n  depType: string,\n  byKey: Map<string, string>,\n  edges: Edge[],\n  recorded: string[],\n): void {\n  recorded.push(depType);\n  const depId = byKey.get(depType);\n  if (depId && depId !== consumerId) edges.push(edge(consumerId, depId, 'injects', depType));\n}",
