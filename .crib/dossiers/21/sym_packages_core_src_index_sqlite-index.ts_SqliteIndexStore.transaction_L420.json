  "source": {
    "text": "  private transaction<T>(fn: () => T): () => T {\n    return () => {\n      this.db.exec('BEGIN');\n      try {\n        const result = fn();\n        this.db.exec('COMMIT');\n        return result;\n      } catch (err) {\n        this.db.exec('ROLLBACK');\n        throw err;\n      }\n    };\n  }",
