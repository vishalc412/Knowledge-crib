  "source": {
    "text": "export function collectCallSites(tokens: Token[], excluded: Set<number>): CsharpCallSite[] {\n  const calls: CsharpCallSite[] = [];\n  let i = 0;\n  while (i < tokens.length) {\n    const tk = tokens[i]!;\n    if (tk.type !== 'NAME') {\n      i++;\n      continue;\n    }\n    const chain: string[] = [tk.value];\n    const line = tk.line;\n    let j = i + 1;\n    while (\n      j < tokens.length &&\n      tokens[j]!.type === 'OP' &&\n      tokens[j]!.value === '.' &&\n      tokens[j + 1] &&\n      tokens[j + 1]!.type === 'NAME'\n    ) {\n      chain.push(tokens[j + 1]!.value);\n      j += 2;\n    }\n    if (j < tokens.length && tokens[j]!.type === 'OP' && tokens[j]!.value === '(') {\n      if (!excluded.has(j)) {\n        calls.push({\n          head: chain[0]!,\n          tail: chain.slice(1),\n          name: chain[chain.length - 1]!,\n          line,\n        });\n      }\n      i = j + 1;\n      continue;\n    }\n    i++;\n  }\n  return calls;\n}",
    "truncated": false,
    "totalLines": 38,
    "startLine": 1693
  },
