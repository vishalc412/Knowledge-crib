  "source": {
    "text": "  private recover(): void {\n    while (this.at().type !== 'eof') {\n      if (this.isPunct(';')) {\n        this.pos++;\n        return;\n      }\n      if (BLOCK_END.has(this.at().text)) return;\n      this.pos++;\n    }\n  }",
