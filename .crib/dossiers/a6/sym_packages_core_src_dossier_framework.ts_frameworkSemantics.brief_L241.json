  "source": {
    "text": "  const brief = (id: string, confidence: number): AdjacentBrief => {\n    const n = soul.getNode(id);\n    if (!n) return { id, confidence };\n    return {\n      id,\n      confidence,\n      ...(n.name ? { name: n.name } : {}),\n      ...(n.qualifiedName ? { qualifiedName: n.qualifiedName } : {}),\n      ...(n.signature ? { signature: n.signature } : {}),\n      ...(n.type ? { type: n.type } : {}),\n      ...(n.file ? { file: n.file } : {}),\n      ...(n.span ? { line: n.span.start } : {}),\n    };\n  };",
    "truncated": false,
    "totalLines": 14,
    "startLine": 241
  },
