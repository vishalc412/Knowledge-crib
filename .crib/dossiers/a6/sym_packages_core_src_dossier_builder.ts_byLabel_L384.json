    "text": "function byLabel(a: AdjacentBrief, b: AdjacentBrief): number {\n  const la = a.qualifiedName ?? a.name ?? a.id;\n  const lb = b.qualifiedName ?? b.name ?? b.id;\n  return la < lb ? -1 : la > lb ? 1 : 0;\n}",
