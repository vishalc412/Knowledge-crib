  "source": {
    "text": "pub fn classify(code: u32) -> Result<String, String> {\n    let label = mk_label(code);\n    if code == 0 {\n        return Err(\"zero code\".to_string());\n    }\n    match code {\n        200 => Ok(label),\n        404 => Ok(String::from(\"missing\")),\n        _ => panic!(\"unexpected code\"),\n    }\n}",
