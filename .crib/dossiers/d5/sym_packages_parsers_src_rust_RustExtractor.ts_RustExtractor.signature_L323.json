  "source": {
    "text": "  private signature(d: RustDef, finalType: string): string {\n    switch (d.kind) {\n      case 'struct':\n        return `struct ${d.name}`;\n      case 'enum':\n        return `enum ${d.name}`;\n      case 'trait':\n        return d.bases.length ? `trait ${d.name}: ${d.bases.join(' + ')}` : `trait ${d.name}`;\n      case 'impl':\n        return d.name; // \"impl Trait for Type\" / \"impl Type\"\n      case 'typealias':\n        return `type ${d.name}`;\n      case 'macro':\n        return `macro ${d.name}`;\n      default:\n        return `fn ${d.name}(${d.params.join(', ')})`;\n    }\n  }",
    "truncated": false,
    "totalLines": 18,
    "startLine": 323
  },
