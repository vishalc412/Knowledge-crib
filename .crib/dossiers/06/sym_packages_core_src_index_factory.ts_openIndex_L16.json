    "text": "export function openIndex(backend: IndexBackend = 'sqlite', opts: OpenIndexOpts = {}): IndexStore {\n  switch (backend) {\n    case 'sqlite':\n      return new SqliteIndexStore(opts.path ?? ':memory:');\n    case 'kuzu':\n      return new KuzuIndexStore();\n  }\n}",
