  "source": {
    "text": "function paramDepType(p: ts.ParameterDeclaration): string | undefined {\n  const injectDec = decors(p).find((d) => simpleName(d) === 'Inject');\n  if (injectDec) {\n    const token = firstInjectToken(injectDec);\n    if (token) return token;\n  }\n  return paramTypeOf(p);\n}",
