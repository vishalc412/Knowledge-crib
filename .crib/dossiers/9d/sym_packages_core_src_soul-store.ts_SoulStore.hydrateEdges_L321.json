  "source": {
    "text": "  private hydrateEdges(): void {\n    const edgesRoot = join(this.cribDirPrivate, 'edges');\n    for (const file of this.walkJsonl(edgesRoot)) {\n      for (const edge of this.readRecords<Edge>(file)) this.edges.set(edge.id, edge);\n    }\n  }",
