  "source": {
    "text": "function parsePnpmWorkspacePatterns(content: string): string[] {\n  const out: string[] = [];\n  let inPackages = false;\n  for (const line of content.split(/\\r?\\n/)) {\n    const trimmed = line.trim();\n    if (!trimmed || trimmed.startsWith('#')) continue;\n    if (/^packages\\s*:/.test(trimmed)) {\n      inPackages = true;\n      continue;\n    }\n    // A new top-level key ends the packages block.\n    if (inPackages && /^[a-zA-Z_-]+\\s*:/.test(trimmed)) {\n      inPackages = false;\n      continue;\n    }\n    if (!inPackages) continue;\n    const m = trimmed.match(/^[-*]\\s+(.+)$/);\n    const raw = m?.[1] ?? trimmed;\n    const val = raw.replace(/,#.*$/, '').trim();\n    if (val) out.push(stripQuotes(val));\n  }\n  return out;\n}",
    "truncated": false,
    "totalLines": 23,
    "startLine": 136
  },
