  "source": {
    "text": "  const visit = (abs) => {\n    const st = statSync(abs);\n    if (st.isDirectory()) {\n      for (const entry of readdirSync(abs).sort()) visit(join(abs, entry));\n    } else {\n      h.update(abs.slice(repo.length));\n      h.update('\\0');\n      h.update(readFileSync(abs));\n      h.update('\\0');\n    }\n  };",
