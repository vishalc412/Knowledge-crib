  "source": {
    "text": "  private skipReturnType(): void {\n    let pdepth = 0;\n    let bdepth = 0;\n    while (!this.atEnd()) {\n      if (pdepth === 0 && bdepth === 0 && (this.isOp('{') || this.isOp(';'))) return;\n      if (this.isOp('(')) pdepth++;\n      else if (this.isOp(')')) pdepth = Math.max(0, pdepth - 1);\n      else if (this.isOp('[')) bdepth++;\n      else if (this.isOp(']')) bdepth = Math.max(0, bdepth - 1);\n      this.next();\n    }\n  }",
    "truncated": false,
    "totalLines": 12,
    "startLine": 953
  },
