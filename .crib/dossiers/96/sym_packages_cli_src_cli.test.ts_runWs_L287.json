  "source": {
    "text": "  const runWs = (args: string[]): { status: number; stdout: string; stderr: string } => {\n    const r = spawnSync(process.execPath, [CLI, ...args], {\n      cwd: wsRepo,\n      encoding: 'utf8',\n      maxBuffer: 32 * 1024 * 1024,\n    });\n    const stripNoise = (s: string): string =>\n      s\n        .split('\\n')\n        .filter((l) => !/ExperimentalWarning|trace-warnings/.test(l))\n        .join('\\n')\n        .trim();\n    return {\n      status: r.status ?? 1,\n      stdout: stripNoise(r.stdout ?? ''),\n      stderr: stripNoise(r.stderr ?? ''),\n    };\n  };",
    "truncated": false,
    "totalLines": 18,
