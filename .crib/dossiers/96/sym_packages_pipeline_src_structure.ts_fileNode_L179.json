  "source": {
    "text": "export function fileNode(root: string, file: FileMeta): Node {\n  const content = safeRead(join(root, file.path));\n  return {\n    id: idFor({ kind: 'file', path: file.path }),\n    kind: 'file',\n    file: file.path,\n    hash: contentHash(content),\n    ...(file.lang ? { lang: file.lang } : {}),\n  };\n}",
