  "source": {
    "text": "  private parseStmts(): JavaStmt[] {\n    const out: JavaStmt[] = [];\n    while (this.i < this.end) {\n      const tk = this.peek();\n      if (this.isOp(';') || this.isOp(',')) {\n        this.next();\n        continue;\n      }\n      if (this.isOp('{')) {\n        // bare nested block (e.g. a brace-wrapped scope) — skip its contents, not modelled.\n        this.skipBraces();\n        continue;\n      }\n      if (this.isOp('}')) break;\n      const before = this.i;\n      const s = this.parseStmt();\n      if (s) out.push(s);\n      else if (this.i === before) this.next(); // progress guard\n    }\n    return out;\n  }",
    "truncated": false,
    "totalLines": 21,
    "startLine": 1104
  },
