  "source": {
    "text": "  private scanOp(): void {\n    const sl = this.line;\n    const sc = this.col;\n    // longest multi-char op match\n    for (const op of MULTI_OPS) {\n      if (this.startsWith(op)) {\n        for (let i = 0; i < op.length; i++) this.advance();\n        this.emit('OP', op, sl, sc);\n        return;\n      }\n    }\n    const c = this.peek();\n    this.advance();\n    this.emit('OP', c, sl, sc);\n  }",
    "truncated": false,
    "totalLines": 15,
    "startLine": 578
  },
