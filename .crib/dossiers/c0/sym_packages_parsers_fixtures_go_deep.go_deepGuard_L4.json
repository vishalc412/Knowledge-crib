  "source": {
    "text": "func deepGuard(kind int, v interface{}) string {\n\tx := \"init\"\n\tdefer func() {\n\t\tif r := recover(); r != nil {\n\t\t\tx = \"recovered\"\n\t\t}\n\t}()\n\tswitch kind {\n\tcase 1:\n\t\tx = \"one\"\n\tcase 2:\n\t\tx = \"two\"\n\tdefault:\n\t\tpanic(\"unknown kind\")\n\t}\n\tswitch t := v.(type) {\n\tcase int:\n\t\treturn x + \"int\"\n\tcase string:\n\t\treturn x + \"string\"\n\tdefault:\n\t\treturn x + \"other\"\n\t}\n}",
    "truncated": false,
    "totalLines": 24,
    "startLine": 4
  },
