  "source": {
    "text": "      }\n      break;\n    }\n    if (this.isOp('(')) this.skipBalancedParens();\n  }\n\n  // --- balanced skip helpers -----------------------------------------------------\n\n  /** From a `(` skip to its matching `)`; returns the close-`)` line. */\n  private skipBalancedParens(): void {\n    if (!this.isOp('(')) return;\n    let depth = 0;\n    while (!this.atEnd()) {\n      const tk = this.peek();\n      if (tk.type === 'OP' && tk.value === '(') depth++;\n      else if (tk.type === 'OP' && tk.value === ')') {\n        depth--;\n        this.next();",
