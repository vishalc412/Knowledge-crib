  "source": {
    "text": "  private parseWith(): PyStmt | null {\n    const line = this.peek().line;\n    this.next(); // 'with'\n    const pred = this.capturePredicate();\n    if (!pred.ok) {\n      this.skipToNewline();\n      return null;\n    }\n    const body = this.parseSuite();\n    return { kind: 'with', line, endLine: stmtsEnd(body, this.lastContentLine, line), body };\n  }",
    "truncated": false,
    "totalLines": 11,
    "startLine": 494
  },
