  "source": {
    "text": "  private resolveCluster(ref: string): Node | undefined {\n    const norm = (x: string): string => (x.startsWith('c:') ? x.slice(2) : x);\n    const r = norm(ref);\n    return [...this.soul.iterate('cluster')].find((c) => norm(c.id) === r);\n  }",
