  "source": {
    "text": "function parsePackages(args: string[]): string[] {\n  const out: string[] = [];\n  for (let i = 0; i < args.length; i++) {\n    if (args[i] === '--package') {\n      const val = args[++i];\n      if (!val) continue;\n      for (const p of val\n        .split(',')\n        .map((s) => s.trim())\n        .filter(Boolean))\n        out.push(p);\n    }\n  }\n  return out;\n}",
