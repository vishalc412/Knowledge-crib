  "source": {
    "text": "def process(value):\n    \"\"\"Process a value, raising on invalid input.\"\"\"\n    result = value * 2\n    try:\n        if result < 0:\n            raise ValueError(\"negative result\")\n        return result\n    except ValueError as e:\n        return -1\n    except (TypeError, KeyError) as e:\n        return -2",
    "truncated": false,
