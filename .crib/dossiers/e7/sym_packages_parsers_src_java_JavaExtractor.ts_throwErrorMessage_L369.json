  "source": {
    "text": "function throwErrorMessage(text: string | undefined): string {\n  if (!text) return '';\n  const expr = text.replace(/^\\s*throw\\s+/, '').trim();\n  const m = expr.match(/\"((?:[^\"\\\\]|\\\\.)*)\"/);\n  return m ? m[1]! : expr;\n}",
