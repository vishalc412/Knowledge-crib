  "source": {
    "text": "  private markNodeDirty(node: Node): void {\n    if (node.kind === 'cluster') {\n      this.clustersDirty = true;\n    } else {\n      this.dirtyNodeShards.add(shardOf(shardKeyForNode(node), this.shardDigits));\n    }\n  }",
