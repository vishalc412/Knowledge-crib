  "source": {
    "text": "const walk = (dir, acc = []) => {\n  for (const entry of readdirSync(dir)) {\n    const p = join(dir, entry);\n    const st = statSync(p);\n    if (st.isDirectory()) {\n      if (entry === 'node_modules' || entry === 'dist' || entry.startsWith('.')) continue;\n      walk(p, acc);\n    } else if (p.endsWith('.test.ts')) {\n      acc.push(p);\n    }\n  }\n  return acc;\n};",
    "truncated": false,
    "totalLines": 13,
    "startLine": 31
  },
