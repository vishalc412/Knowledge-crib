  "source": {
    "text": "  parseBody(openIdx: number): JavaStmt[] {\n    const closeIdx = this.matchBrace(openIdx);\n    if (closeIdx < 0) return []; // unterminated body — degrade to no statements\n    this.i = openIdx + 1;\n    this.end = closeIdx;\n    return this.parseStmts();\n  }",
