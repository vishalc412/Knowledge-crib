  "source": {
    "text": "  private rangeHasRecover(start: number, end: number): boolean {\n    for (let i = start; i < end && i < this.t.length; i++) {\n      const tk = this.t[i]!;\n      if (tk.type === 'NAME' && tk.value === 'recover') {\n        const nx = this.t[i + 1];\n        if (nx && nx.type === 'OP' && nx.value === '(') return true;\n      }\n    }\n    return false;\n  }",
    "truncated": false,
