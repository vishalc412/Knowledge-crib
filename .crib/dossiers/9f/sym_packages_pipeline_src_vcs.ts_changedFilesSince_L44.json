  "source": {
    "text": "export function changedFilesSince(root: string, since: string): string[] {\n  const out = git(root, ['diff', '--name-only', '--no-renames', `${since}..HEAD`]);\n  if (out === undefined) throw new NotARepoError(root);\n  return out\n    .split('\\n')\n    .map((l) => l.trim())\n    .filter((l) => l.length > 0)\n    .map(toPosix);\n}",
    "truncated": false,
