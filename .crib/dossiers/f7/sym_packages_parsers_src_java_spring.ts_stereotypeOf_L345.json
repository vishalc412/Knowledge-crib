  "source": {
    "text": "function stereotypeOf(def: JavaDef): string | undefined {\n  for (const a of def.annotations) {\n    const s = CLASS_STEREOTYPE[a];\n    if (s) return s;\n  }\n  if (def.kind === 'interface' && def.bases.some((b) => REPOSITORY_BASES.has(b))) {\n    return 'repository';\n  }\n  return undefined;\n}",
