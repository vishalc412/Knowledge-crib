  "source": {
    "text": "  buildFromSoul(soul: SoulStore): void {\n    this.reset();\n    const insertMany = this.db.transaction(() => {\n      for (const node of soul.iterate()) this.insertNode(node);\n      for (const edge of soul.iterateEdges()) this.insertEdge(edge);\n    });\n    insertMany();\n  }",
