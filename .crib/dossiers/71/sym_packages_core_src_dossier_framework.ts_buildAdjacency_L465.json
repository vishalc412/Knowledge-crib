  "source": {
    "text": "function buildAdjacency(soul: SoulStore, dir: 'out' | 'in'): Map<string, Edge[]> {\n  const m = new Map<string, Edge[]>();\n  for (const e of soul.iterateEdges()) {\n    if (!FRAMEWORK_RELS.has(e.rel)) continue;\n    const key = dir === 'out' ? e.src : e.dst;\n    const arr = m.get(key);\n    if (arr) arr.push(e);\n    else m.set(key, [e]);\n  }\n  return m;\n}",
    "truncated": false,
    "totalLines": 11,
    "startLine": 465
  },
