  "source": {
    "text": "function basenameNoExt(file: string | undefined): string {\n  if (!file) return '';\n  const base = file.split('/').pop() ?? file;\n  const dot = base.lastIndexOf('.');\n  return dot > 0 ? base.slice(0, dot) : base;\n}",
