  "source": {
    "text": "  query(queryText: string, floor: number, k: number): Array<{ id: string; score: number }> {\n    if (this.ids.length === 0 || queryText.trim().length === 0) return [];\n    const q = this.embedder.embed(queryText);\n    const qn = norm(q);\n    if (qn === 0) return [];\n    const scored: Array<{ id: string; score: number }> = [];\n    for (let i = 0; i < this.vecs.length; i++) {\n      const v = this.vecs[i]!;\n      const vn = norm(v);\n      if (vn === 0) continue;\n      const sim = dot(q, v) / (qn * vn);\n      if (sim >= floor) scored.push({ id: this.ids[i]!, score: sim });\n    }\n    scored.sort((a, b) => b.score - a.score || (a.id < b.id ? -1 : 1));\n    return scored.slice(0, k);\n  }",
    "truncated": false,
    "totalLines": 16,
    "startLine": 60
  },
