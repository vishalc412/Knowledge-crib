  "source": {
    "text": "  private isNumberPart(c: string): boolean {\n    return (\n      (c >= '0' && c <= '9') ||\n      (c >= 'a' && c <= 'z') ||\n      (c >= 'A' && c <= 'Z') ||\n      c === '_' ||\n      c === '.' ||\n      c === '+' ||\n      c === '-'\n    );\n  }",
