  "source": {
    "text": "function triggersSemicolon(t: Token | undefined): boolean {\n  if (!t) return false;\n  if (t.type === 'NAME' || t.type === 'NUMBER' || t.type === 'STRING' || t.type === 'CHAR')\n    return true;\n  if (t.type === 'OP')\n    return (\n      t.value === '++' || t.value === '--' || t.value === ')' || t.value === '}' || t.value === ']'\n    );\n  return false;\n}",
    "truncated": false,
    "totalLines": 10,
    "startLine": 235
  },
