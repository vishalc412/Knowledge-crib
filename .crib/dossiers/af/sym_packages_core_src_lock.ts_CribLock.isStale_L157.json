  "source": {
    "text": "  private isStale(): boolean {\n    let st: Stats;\n    try {\n      st = statSync(this.path);\n    } catch {\n      return true; // vanished between the failed create and now — caller recreates\n    }\n    const age = Date.now() - st.mtimeMs;\n    return !pidAlive(this.readHolder()) || age > this.staleMs;\n  }",
