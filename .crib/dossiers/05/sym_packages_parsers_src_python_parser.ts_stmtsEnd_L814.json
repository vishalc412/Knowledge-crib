  "source": {
    "text": "function stmtsEnd(stmts: PyStmt[], lastContentLine: number, startLine: number): number {\n  let end = Math.max(lastContentLine, startLine);\n  for (const s of stmts) end = Math.max(end, s.endLine);\n  return end;\n}",
    "truncated": false,
    "totalLines": 5,
