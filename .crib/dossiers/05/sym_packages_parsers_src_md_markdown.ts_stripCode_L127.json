  "source": {
    "text": "function stripCode(body: string): string {\n  const noInline = body.replace(INLINE_CODE, ' ');\n  const lines = noInline.split('\\n');\n  const out: string[] = [];\n  let inFence = false;\n  for (const line of lines) {\n    if (FENCE.test(line)) {\n      inFence = !inFence;\n      continue;\n    }\n    if (!inFence) out.push(line);\n  }\n  return out.join('\\n');\n}",
    "truncated": false,
    "totalLines": 14,
    "startLine": 127
  },
