  "source": {
    "text": "  const consumeDotted = (k: number): { parts: string[]; j: number } => {\n    const parts: string[] = [];\n    let j = k;\n    while (j < tokens.length && tokens[j]!.type === 'NAME') {\n      parts.push(tokens[j]!.value);\n      j++;\n      if (isOp(j, '.')) {\n        j++;\n        continue;\n      }\n      break;\n    }\n    return { parts, j };\n  };",
