  "source": {
    "text": "  private caseBranch(pat: string, line: number): string {\n    const id = this.ctx.idFor('case-branch', { file: this.path, line });\n    if (!this.caseBranchSeen.has(id)) {\n      this.caseBranchSeen.add(id);\n      this.nodes.push({\n        id,\n        kind: 'case-branch',\n        branch: 'CASE',\n        expr: pat,\n        file: this.path,\n        span: { start: line, end: line },\n        lang: 'rust',\n        hash: this.ctx.hash(`${this.path}:case:${line}:${pat}`),\n        whenSelector: pat,\n      });\n    }\n    return id;\n  }",
    "truncated": false,
    "totalLines": 18,
    "startLine": 711
  },
