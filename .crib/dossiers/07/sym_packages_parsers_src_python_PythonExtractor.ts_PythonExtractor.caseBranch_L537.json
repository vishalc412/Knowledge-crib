  "source": {
    "text": "  private caseBranch(w: WalkCtx, pattern: string, line: number): string {\n    const id = w.ctx.idFor('case-branch', { file: w.path, line });\n    if (!w.caseBranchSeen.has(id)) {\n      w.caseBranchSeen.add(id);\n      w.nodes.push({\n        id,\n        kind: 'case-branch',\n        branch: 'CASE',\n        expr: pattern,\n        whenSelector: pattern || '_',\n        file: w.path,\n        span: { start: line, end: line },\n        lang: 'python',\n        hash: w.ctx.hash(`${w.path}:case:${line}:${pattern}`),\n      });\n    }\n    return id;\n  }",
    "truncated": false,
    "totalLines": 18,
    "startLine": 537
  },
