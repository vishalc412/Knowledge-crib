  "source": {
    "text": "  private countRawHashes(from: number): number | undefined {\n    let j = from;\n    let n = 0;\n    while (this.peek(j) === '#') {\n      j++;\n      n++;\n    }\n    return this.peek(j) === '\"' ? n : undefined;\n  }",
