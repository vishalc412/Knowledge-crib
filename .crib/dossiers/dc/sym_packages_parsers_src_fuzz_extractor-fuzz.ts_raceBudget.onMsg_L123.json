  "source": {
    "text": "    const onMsg = (msg: WorkerOutMsg) => {\n      if (msg.kind === 'result' && msg.idx === idx) {\n        if (settled) return;\n        settled = true;\n        clearTimeout(timer);\n        w.off('message', onMsg);\n        resolve({ idx, outcome: msg.outcome, reason: msg.reason });\n      }\n    };",
