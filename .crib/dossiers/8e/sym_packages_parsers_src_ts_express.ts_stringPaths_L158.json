  "source": {
    "text": "function stringPaths(arg: ts.Expression): string[] {\n  if (ts.isStringLiteral(arg)) return [arg.text];\n  if (ts.isArrayLiteralExpression(arg)) {\n    const out: string[] = [];\n    for (const el of arg.elements) {\n      if (ts.isStringLiteral(el)) out.push(el.text);\n    }\n    return out;\n  }\n  return [];\n}",
