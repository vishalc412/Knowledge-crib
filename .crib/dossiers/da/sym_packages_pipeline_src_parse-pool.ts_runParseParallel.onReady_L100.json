  "source": {
    "text": "        const onReady = (msg: WorkerOutMsg) => {\n          if (msg.kind === 'ready') {\n            w.off('message', onReady);\n            resolve();\n          } else if (msg.kind === 'error') {\n            reject(new Error(`worker init failed: ${msg.message}`));\n          }\n        };",
