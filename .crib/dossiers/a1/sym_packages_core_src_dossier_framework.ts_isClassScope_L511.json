  "source": {
    "text": "function isClassScope(node: Node, incoming: Map<string, Edge[]>): boolean {\n  if (node.kind !== 'symbol') return false;\n  if (node.stereotype && CLASS_STEREOTYPES.has(node.stereotype)) return true;\n  if (node.type && CLASS_TYPES.has(node.type)) return true;\n  const ins = incoming.get(node.id);\n  return !!ins && ins.some((e) => e.rel === 'member-of');\n}",
    "truncated": false,
    "totalLines": 7,
    "startLine": 511
  },
