  "source": {
    "text": "  private readParenColumnList(): string[] {\n    if (!this.isPunct('(')) return [];\n    this.pos++; // past '('\n    const out: string[] = [];\n    let depth = 1;\n    while (this.at().type !== 'eof' && depth > 0) {\n      if (this.isPunct('(')) {\n        depth++;\n        this.pos++;\n        continue;\n      }\n      if (this.isPunct(')')) {\n        depth--;\n        this.pos++;\n        continue;\n      }\n      if (this.isPunct(',')) {\n        this.pos++;\n        continue;\n      }\n      if (this.at().type === 'word') {\n        out.push(this.next().raw);\n        continue;\n      }\n      this.pos++; // stray (sizing/keywords tolerated)\n    }\n    return out;\n  }",
    "truncated": false,
    "totalLines": 28,
    "startLine": 402
  },
