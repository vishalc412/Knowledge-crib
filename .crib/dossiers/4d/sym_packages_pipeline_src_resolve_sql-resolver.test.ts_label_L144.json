  "source": {
    "text": "function label(soul: SoulStore, id: string): string {\n  const n: Node | undefined = [...soul.iterate()].find((x) => x.id === id);\n  if (!n) return id;\n  switch (n.kind) {\n    case 'symbol':\n      return `sym:${n.qualifiedName ?? n.name}`;\n    case 'table':\n      return `table:${n.name}`;\n    case 'column':\n      return `col:${n.table}.${n.name}`;\n    case 'statement':\n      return `stmt:${shortFile(n.file)}:${n.sqlKind ?? n.type}`;\n    case 'condition':\n      return `cond:${shortFile(n.file)}:L${n.span?.start}`;\n    default:\n      return n.kind;\n  }\n}",
    "truncated": false,
    "totalLines": 18,
    "startLine": 144
  },
