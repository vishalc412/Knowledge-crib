  "source": {
    "text": "      stmts,\n    };\n  }\n\n  /**\n   * Like {@link parseParamList} but also captures each parameter's TYPE head (the first NAME of the\n   * parameter, before generics/array dims). `UserRepo repo` → {name:'repo', type:'UserRepo'};\n   * `final List<User> us` → {name:'us', type:'List'}. The DI graph reads these types.\n   */\n  private parseParamListTyped(): Array<{ name: string; type?: string }> {\n    if (!this.isOp('(')) return [];\n    this.next(); // (\n    const out: Array<{ name: string; type?: string }> = [];\n    let pdepth = 1;\n    let firstName: string | undefined;\n    let lastName: string | undefined;\n    const flush = (): void => {\n      if (lastName)\n        out.push(\n          firstName && firstName !== lastName\n            ? { name: lastName, type: firstName }\n            : { name: lastName },\n        );\n      firstName = undefined;\n      lastName = undefined;\n    };\n    while (!this.atEnd() && pdepth > 0) {\n      const tk = this.peek();\n      if (tk.type === 'OP' && tk.value === '(') {\n        pdepth++;\n        this.next();\n        continue;\n      }\n      if (tk.type === 'OP' && tk.value === ')') {\n        pdepth--;\n        this.next();\n        if (pdepth === 0) flush();\n        continue;\n      }\n      if (pdepth === 1 && tk.type === 'OP' && tk.value === ',') {\n        flush();\n        this.next();\n        continue;\n      }\n      // parameter annotation (`@RequestBody`, `@PathVariable(\"id\")`, `@Valid`): skip the annotation",
    "truncated": false,
    "totalLines": 45,
    "startLine": 521
  },
