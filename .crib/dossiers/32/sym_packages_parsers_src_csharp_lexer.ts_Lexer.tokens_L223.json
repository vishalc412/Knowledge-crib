  "source": {
    "text": "  tokens(): Token[] {\n    while (this.pos < this.src.length) {\n      const ch = this.peek();\n      // whitespace\n      if (ch === ' ' || ch === '\\t' || ch === '\\r' || ch === '\\n' || ch === '\\f') {\n        this.advance();\n        continue;\n      }\n      // line comment\n      if (ch === '/' && this.peek(1) === '/') {\n        this.skipLineComment();\n        continue;\n      }\n      // block comment (NOT nested in C#)\n      if (ch === '/' && this.peek(1) === '*') {\n        this.skipBlockComment();\n        continue;\n      }\n      // string literal — four families, dispatched by the preceding `@`/`$` flags\n      if (ch === '@' && this.peek(1) === '\"') {\n        this.scanVerbatimString(1, false);\n        continue;\n      }\n      if (ch === '$' && this.peek(1) === '\"') {\n        this.scanInterpolatedString(1);\n        continue;\n      }\n      if (ch === '@' && this.peek(1) === '$' && this.peek(2) === '\"') {\n        this.scanVerbatimString(2, true);\n        continue;\n      }\n      if (ch === '$' && this.peek(1) === '@' && this.peek(2) === '\"') {\n        this.scanVerbatimString(2, true);\n        continue;\n      }\n      if (ch === '\"') {\n        this.scanRegularOrRawString();\n        continue;\n      }\n      // char literal\n      if (ch === \"'\") {\n        this.scanChar();\n        continue;\n      }\n      // number\n      if (this.isNumberStart(ch)) {\n        this.scanNumber();\n        continue;\n      }\n      // identifier / keyword (incl. `@` verbatim identifiers like `@class`)\n      if (this.isIdentStart(ch)) {\n        this.scanIdent();\n        continue;\n      }\n      // operator (longest match)\n      this.scanOp();\n    }\n    this.out.push({ type: 'EOF', value: '', line: this.line, col: this.col });\n    return this.out;\n  }",
    "truncated": false,
    "totalLines": 60,
    "startLine": 223
  },
