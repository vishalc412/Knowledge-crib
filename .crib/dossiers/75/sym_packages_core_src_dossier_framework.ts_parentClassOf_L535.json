    "text": "function parentClassOf(method: Node, outgoing: Map<string, Edge[]>): string | undefined {\n  for (const e of outgoing.get(method.id) ?? []) {\n    if (e.rel !== 'member-of') continue;\n    return e.dst;\n  }\n  return undefined;\n}",
