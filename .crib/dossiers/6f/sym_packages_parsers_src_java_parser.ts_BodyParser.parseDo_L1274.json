  "source": {
    "text": "  private parseDo(startLine: number): JavaStmt {\n    this.next(); // do\n    const body = this.parseBlockOrStmt();\n    let predicate: string | undefined;\n    if (this.peek().type === 'NAME' && this.peek().value === 'while') {\n      this.next(); // while\n      predicate = this.readParenText();\n    }\n    if (this.isOp(';')) this.next();\n    return {\n      kind: 'do',\n      startLine,\n      endLine: this.branchEnd(body),\n      predicate,\n      predicateLine: startLine,\n      body,\n    };\n  }",
    "truncated": false,
    "totalLines": 18,
    "startLine": 1274
  },
