  "source": {
    "text": "function costOf(run) {\n  const perBucket = {};\n  let total = 0;\n  for (const b of BUCKETS) {\n    const c = bucketCost(run[b], PRICE[RATE_OF[b]]);\n    perBucket[b] = usd(c);\n    total += c;\n  }\n  return { perBucket, totalUsd: usd(total), totalTokens: BUCKETS.reduce((s, b) => s + run[b], 0) };\n}",
    "truncated": false,
