  "source": {
    "text": "export function withCribLock<T>(opts: CribLockOptions, fn: () => T): T {\n  const lock = new CribLock(opts);\n  lock.acquire();\n  try {\n    return fn();\n  } finally {\n    lock.release();\n  }\n}",
