  "source": {
    "text": "const gitInit = (repo) => {\n  const g = (args) =>\n    execFileSync('git', ['-C', repo, ...args], {\n      encoding: 'utf8',\n      stdio: ['ignore', 'pipe', 'pipe'],\n    });\n  g(['init']);\n  g(['config', 'user.name', AUTHOR_NAME]);\n  g(['config', 'user.email', AUTHOR_EMAIL]);\n};",
