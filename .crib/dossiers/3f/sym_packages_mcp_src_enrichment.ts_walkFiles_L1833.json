  "source": {
    "text": "function walkFiles(root: string): string[] {\n  if (!existsSync(root)) return [];\n  const out: string[] = [];\n  for (const name of readdirSync(root, { withFileTypes: true })) {\n    const path = join(root, name.name);\n    if (name.isDirectory()) out.push(...walkFiles(path));\n    else out.push(path);\n  }\n  return out;\n}",
    "truncated": false,
