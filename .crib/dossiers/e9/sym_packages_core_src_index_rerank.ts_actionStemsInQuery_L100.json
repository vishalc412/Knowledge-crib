  "source": {
    "text": "export function actionStemsInQuery(query: string): Set<string> {\n  const q = query.toLowerCase();\n  const stems = new Set<string>();\n  for (const stem of ACTION_STEMS) {\n    if (q.includes(stem)) stems.add(stem);\n  }\n  return stems;\n}",
