  "source": {
    "text": "  const bodyOf = (src: string): JavaStmt[] => {\n    const m = parse(src);\n    const c = find(m.defs, 'C');\n    const meth = c!.body.find((d) => d.kind === 'method' || d.kind === 'constructor');\n    return meth?.stmts ?? [];\n  };",
