    "text": "function extractPanicMessage(text: string): string {\n  const lit = extractStringLiteral(text);\n  if (lit !== undefined) return lit;\n  return text\n    .replace(/^panic\\s*\\(/, '')\n    .replace(/\\s*\\)\\s*$/, '')\n    .trim();\n}",
