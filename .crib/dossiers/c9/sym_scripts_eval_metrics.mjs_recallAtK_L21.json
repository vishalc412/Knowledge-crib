  "source": {
    "text": "export function recallAtK(retrieved, expected, k) {\n  const want = new Set(expected);\n  if (want.size === 0) return 0;\n  const top = retrieved.slice(0, k);\n  let hit = 0;\n  for (const id of top) if (want.has(id)) hit += 1;\n  return hit / want.size;\n}",
    "truncated": false,
