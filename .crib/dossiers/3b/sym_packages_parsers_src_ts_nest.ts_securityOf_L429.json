  "source": {
    "text": "function securityOf(decs: ts.Decorator[]): Record<string, string> | undefined {\n  const out: Record<string, string> = {};\n  for (const d of decs) {\n    const n = simpleName(d);\n    if (!SECURITY_ANNOS.has(n)) continue;\n    const args = decArgs(d);\n    if (n === 'Roles' || n === 'Permissions') {\n      const vals = args\n        .filter(ts.isStringLiteral)\n        .map((a) => a.text)\n        .join('|');\n      if (vals) out[n] = vals;\n    } else {\n      // @UseGuards(G1, G2) → the guard class refs joined.\n      const names = args\n        .map((a) => a.getText())\n        .filter((t) => t.length)\n        .join('|');\n      if (names) out[n] = names;\n    }\n  }\n  return Object.keys(out).length ? out : undefined;\n}",
    "truncated": false,
    "totalLines": 23,
    "startLine": 429
  },
