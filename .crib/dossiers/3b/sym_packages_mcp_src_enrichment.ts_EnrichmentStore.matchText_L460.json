  "source": {
    "text": "  matchText(q: string, limit: number): LlmArtifact[] {\n    const terms = q\n      .toLowerCase()\n      .split(/\\s+/)\n      .map((t) => t.trim())\n      .filter(Boolean);\n    if (terms.length === 0) return [];\n    return this.allArtifacts()\n      .filter((a) => !this.isStale(a) && terms.some((term) => artifactText(a).includes(term)))\n      .slice(0, limit);\n  }",
    "truncated": false,
