  "source": {
    "text": "function splitTopLevelCommas(s: string): string[] {\n  const out: string[] = [];\n  let depth = 0;\n  let inStr = false;\n  let buf = '';\n  for (let i = 0; i < s.length; i++) {\n    const c = s[i];\n    if (c === \"'\") {\n      inStr = !inStr;\n      buf += c;\n      continue;\n    }\n    if (inStr) {\n      buf += c;\n      continue;\n    }\n    if (c === '(') depth++;\n    else if (c === ')') depth = Math.max(0, depth - 1);\n    if (c === ',' && depth === 0) {\n      out.push(buf);\n      buf = '';\n      continue;\n    }\n    buf += c;\n  }\n  if (buf.length > 0) out.push(buf);\n  return out;\n}",
    "truncated": false,
    "totalLines": 28,
    "startLine": 1338
  },
