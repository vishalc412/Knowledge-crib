  "source": {
    "text": "function matchKV(s: string, key: string): string | undefined {\n  const re = new RegExp(`\\\\b${key}\\\\s*=\\\\s*(\\\\{[^}]*\\\\}|[^,}]+)`);\n  const m = re.exec(s);\n  return m ? m[1]!.trim().replace(/\"/g, '') : undefined;\n}",
