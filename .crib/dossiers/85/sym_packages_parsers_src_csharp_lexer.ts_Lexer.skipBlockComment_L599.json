  "source": {
    "text": "  private skipBlockComment(): void {\n    this.advance(); // /\n    this.advance(); // *\n    while (this.pos < this.src.length) {\n      if (this.peek() === '*' && this.peek(1) === '/') {\n        this.advance();\n        this.advance();\n        return;\n      }\n      this.advance();\n    }\n  }",
