  "source": {
    "text": "  private exceptionHandler(w: WalkCtx, selector: string, line: number): string {\n    const id = w.ctx.idFor('exception-handler', { file: w.path, line });\n    if (!w.excSeen.has(id)) {\n      w.excSeen.add(id);\n      w.nodes.push({\n        id,\n        kind: 'exception-handler',\n        whenSelector: selector,\n        file: w.path,\n        span: { start: line, end: line },\n        lang: 'python',\n        hash: w.ctx.hash(`${w.path}:exc:${line}:${selector}`),\n      });\n    }\n    return id;\n  }",
    "truncated": false,
    "totalLines": 16,
    "startLine": 519
  },
