  "source": {
    "text": "    const famOf = (id: string): 'ts' | 'py' | undefined => {\n      const n = allNodes.find((x) => x.id === id);\n      const f = n?.file;\n      if (!f) return undefined;\n      if (TS_EXTS.some((e) => f.endsWith(e))) return 'ts';\n      if (PY_EXTS.some((e) => f.endsWith(e))) return 'py';\n      return undefined;\n    };",
