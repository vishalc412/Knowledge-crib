  "source": {
    "text": "export function ownerNode(name: string, email?: string): Node {\n  const id = email ? idFor({ kind: 'owner', email }) : idFor({ kind: 'owner-name', name });\n  return {\n    id,\n    kind: 'owner',\n    hash: contentHash(id),\n    name,\n    ...(email ? { email } : {}),\n  };\n}",
