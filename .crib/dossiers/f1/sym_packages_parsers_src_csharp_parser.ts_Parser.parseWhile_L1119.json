  "source": {
    "text": "  private parseWhile(startLine: number): CsharpStmt {\n    this.next(); // 'while'\n    const predicate = this.readParenText();\n    const body = this.parseStmtBody();\n    return {\n      kind: 'loop',\n      loopKind: 'while',\n      startLine,\n      endLine: this.prevLine(),\n      predicate,\n      body,\n    };\n  }",
