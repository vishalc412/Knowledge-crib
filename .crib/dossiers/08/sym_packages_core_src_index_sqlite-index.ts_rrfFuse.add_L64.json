  "source": {
    "text": "  const add = (hits: Hit[]) => {\n    for (let i = 0; i < hits.length; i++) {\n      const h = hits[i]!;\n      const rank = i + 1;\n      score.set(h.id, (score.get(h.id) ?? 0) + 1 / (RRF_K + rank));\n      if (!meta.has(h.id)) meta.set(h.id, h);\n    }\n  };",
