  "source": {
    "text": "function isAssignmentWithCall(expr: ts.Expression): boolean {\n  if (ts.isBinaryExpression(expr) && expr.operatorToken.kind === ts.SyntaxKind.EqualsToken) {\n    return containsCall(expr.right);\n  }\n  return false;\n}",
