  "source": {
    "text": "  private isIdentStart(c: string): boolean {\n    return (\n      (c >= 'a' && c <= 'z') ||\n      (c >= 'A' && c <= 'Z') ||\n      c === '_' ||\n      c === '@' ||\n      c.charCodeAt(0) > 127\n    );\n  }",
