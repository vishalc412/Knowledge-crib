  "source": {
    "text": "  private parseDottedTypeName(): string | undefined {\n    if (!this.isNameToken()) return undefined;\n    const parts: string[] = [this.peek().value];\n    this.next();\n    while (this.isOp('.') && this.peek(1).type === 'NAME') {\n      this.next(); // .\n      parts.push(this.peek().value);\n      this.next();\n    }\n    return parts.join('.');\n  }",
    "truncated": false,
    "totalLines": 11,
    "startLine": 833
  },
