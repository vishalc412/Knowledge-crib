  "source": {
    "text": "  async extract(file: FileMeta, ctx: ExtractCtx): Promise<ExtractResult> {\n    try {\n      const text = await ctx.readText();\n      const fileId = ctx.idFor('file', { path: file.path });\n      return this.parse(file.path, fileId, text, ctx);\n    } catch {\n      return { nodes: [], edges: [] };\n    }\n  }",
