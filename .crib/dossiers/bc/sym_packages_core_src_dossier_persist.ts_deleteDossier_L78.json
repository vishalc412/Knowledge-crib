  "source": {
    "text": "export function deleteDossier(cribDir: string, nodeId: string): void {\n  const path = dossierPath(cribDir, nodeId);\n  if (existsSync(path)) {\n    try {\n      rmSync(path, { force: true });\n    } catch {\n      // swallow — cleanup is best-effort\n    }\n  }\n}",
