tLineEnd(j) ? j + 1 : j;\n      continue;\n    }\n    if (tk.value === 'import') {\n      const line = tk.line;\n      let j = i + 1;\n      const isStatic = isNameVal(j, 'static');\n      if (isStatic) j++;",
