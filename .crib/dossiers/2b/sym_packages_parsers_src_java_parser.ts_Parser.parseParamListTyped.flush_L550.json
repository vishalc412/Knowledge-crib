  "source": {
    "text": "    const flush = (): void => {\n      if (lastName)\n        out.push(\n          firstName && firstName !== lastName\n            ? {\n                name: lastName,\n                type: firstName,\n                ...(paramAnnos.length ? { annotations: paramAnnos } : {}),\n              }\n            : { name: lastName, ...(paramAnnos.length ? { annotations: paramAnnos } : {}) },\n        );\n      firstName = undefined;\n      lastName = undefined;\n      paramAnnos = [];\n    };",
