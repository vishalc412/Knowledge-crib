  "source": {
    "text": "function positionalsOf(args: string[]): string[] {\n  const out: string[] = [];\n  for (let i = 0; i < args.length; i++) {\n    const a = args[i]!;\n    if (VALUE_FLAGS.has(a)) {\n      i++; // drop the value token too\n      continue;\n    }\n    if (a.startsWith('-')) continue;\n    out.push(a);\n  }\n  return out;\n}",
    "truncated": false,
    "totalLines": 13,
