  "source": {
    "text": "function parseExcludes(args: string[]): Set<string> {\n  const ignores = new Set(DEFAULT_IGNORES);\n  for (let i = 0; i < args.length; i++) {\n    if (args[i] === '--exclude') {\n      const val = args[++i];\n      if (!val) continue;\n      for (const d of val\n        .split(',')\n        .map((s) => s.trim())\n        .filter(Boolean))\n        ignores.add(d);\n    }\n  }\n  return ignores;\n}",
    "truncated": false,
