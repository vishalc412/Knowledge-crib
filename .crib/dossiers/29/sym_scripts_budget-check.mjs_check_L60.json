    "text": "async function check(name, fn) {\n  try {\n    await fn();\n    process.stdout.write(`  ok  ${name}\\n`);\n  } catch (e) {\n    const msg = e instanceof Error ? e.message : String(e);\n    failures.push(`${name}: ${msg}`);\n    process.stdout.write(`FAIL  ${name}: ${msg}\\n`);\n  }\n}",
