  "source": {
    "text": "  private skipArrowBody(): number {\n    if (!this.isOp('=>')) return this.peek().line;\n    this.next();\n    let pdepth = 0;\n    let bdepth = 0;\n    let brace = 0;\n    while (!this.atEnd()) {\n      const tk = this.peek();\n      if (pdepth === 0 && bdepth === 0 && brace === 0 && this.isOp(';')) {\n        const line = tk.line;\n        this.next();\n        return line;\n      }\n      if (tk.type === 'OP') {\n        if (tk.value === '(') pdepth++;\n        else if (tk.value === ')') pdepth = Math.max(0, pdepth - 1);\n        else if (tk.value === '[') bdepth++;\n        else if (tk.value === ']') bdepth = Math.max(0, bdepth - 1);\n        else if (tk.value === '{') brace++;\n        else if (tk.value === '}') {\n          if (brace > 0) brace--;\n          else break;\n        }\n      }\n      this.next();\n    }\n    return this.peek().line;\n  }",
    "truncated": false,
    "totalLines": 28,
