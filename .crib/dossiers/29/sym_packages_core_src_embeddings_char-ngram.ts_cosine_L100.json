  "source": {
    "text": "export function cosine(a: Vec, b: Vec): number {\n  if (a.length !== b.length) return 0;\n  let dot = 0;\n  for (let i = 0; i < a.length; i++) dot += (a[i] ?? 0) * (b[i] ?? 0);\n  return dot;\n}",
    "truncated": false,
