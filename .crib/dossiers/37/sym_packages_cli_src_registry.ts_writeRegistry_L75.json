  "source": {
    "text": "export function writeRegistry(reg: Registry, env: NodeJS.ProcessEnv = process.env): void {\n  const path = registryPath(env);\n  mkdirSync(dirname(path), { recursive: true });\n  const tmp = `${path}.tmp`;\n  writeFileSync(tmp, `${JSON.stringify(reg, null, 2)}\\n`, 'utf8');\n  renameSync(tmp, path);\n}",
    "truncated": false,
