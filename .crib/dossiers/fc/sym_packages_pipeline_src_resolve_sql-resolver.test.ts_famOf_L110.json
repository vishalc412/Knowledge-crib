  "source": {
    "text": "    const famOf = (id: string): 'ts' | 'sql' | undefined => {\n      const n = allNodes.find((x) => x.id === id);\n      const f = n?.file;\n      if (!f) return undefined;\n      if (TS_EXTS.some((e) => f.endsWith(e))) return 'ts';\n      if (SQL_FILE_EXTS.some((e) => f.endsWith(e))) return 'sql';\n      return undefined;\n    };",
