  "source": {
    "text": "function extractCodeRefs(body: string): string[] {\n  const refs = new Set<string>();\n  // inline code\n  for (const m of body.matchAll(INLINE_CODE)) {\n    const tok = (m[1] ?? '').trim();\n    if (tok) refs.add(tok);\n  }\n  // fenced code: collect identifier-ish tokens line by line\n  const lines = body.split('\\n');\n  let inFence = false;\n  for (const line of lines) {\n    if (FENCE.test(line)) {\n      inFence = !inFence;\n      continue;\n    }\n    if (!inFence) continue;\n    for (const tok of line.split(/[^A-Za-z0-9_.#/]+/)) {\n      if (tok.length > 1) refs.add(tok);\n    }\n  }\n  return [...refs];\n}",
    "truncated": false,
    "totalLines": 22,
    "startLine": 94
  },
