  "source": {
    "text": "  private skipBalancedParens(): void {\n    if (!this.isOp('(')) return;\n    let depth = 0;\n    while (!this.atEnd()) {\n      const tk = this.peek();\n      if (tk.type === 'OP' && tk.value === '(') depth++;\n      else if (tk.type === 'OP' && tk.value === ')') {\n        depth--;\n        this.next();\n        if (depth === 0) return;\n        continue;\n      }\n      this.next();\n    }\n  }",
    "truncated": false,
    "totalLines": 15,
    "startLine": 887
  },
