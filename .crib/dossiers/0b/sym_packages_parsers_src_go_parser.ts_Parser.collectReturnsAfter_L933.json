  "source": {
    "text": "  private collectReturnsAfter(seg: Token[], openIdx: number): string {\n    // skip balanced `(...)` starting at openIdx\n    let i = openIdx + 1;\n    let pdepth = 1;\n    while (i < seg.length && pdepth > 0) {\n      const tk = seg[i]!;\n      if (tk.type === 'OP' && tk.value === '(') pdepth++;\n      else if (tk.type === 'OP' && tk.value === ')') pdepth--;\n      i++;\n    }\n    return seg\n      .slice(i)\n      .map((tk) => tk.value)\n      .join('')\n      .trim();\n  }",
    "truncated": false,
    "totalLines": 16,
    "startLine": 933
  },
