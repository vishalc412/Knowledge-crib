    "text": "function dot(a: Vec, b: Vec): number {\n  let s = 0;\n  const n = Math.min(a.length, b.length);\n  for (let i = 0; i < n; i++) s += (a[i] ?? 0) * (b[i] ?? 0);\n  return s;\n}",
