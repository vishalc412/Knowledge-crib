    "text": "function collectCargoMembers(segment: string, out: string[]): void {\n  for (const tok of segment.split(/[\\s,\\[\\]]+/)) {\n    const v = stripQuotes(tok.trim());\n    if (v && v !== '') out.push(v);\n  }\n}",
