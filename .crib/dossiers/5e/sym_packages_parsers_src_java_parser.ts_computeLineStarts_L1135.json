  "source": {
    "text": "function computeLineStarts(src: string): number[] {\n  const starts = [0];\n  for (let i = 0; i < src.length; i++) {\n    if (src[i] === '\\n') starts.push(i + 1);\n  }\n  return starts;\n}",
