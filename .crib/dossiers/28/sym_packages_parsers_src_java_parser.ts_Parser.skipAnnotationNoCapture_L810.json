  "source": {
    "text": "  private skipAnnotationNoCapture(): void {\n    this.next(); // '@'\n    while (this.isNameToken() || this.isOp('.')) {\n      this.next();\n      if (this.isOp('.')) {\n        this.next();\n        continue;\n      }\n      break;\n    }\n    if (this.isOp('(')) this.skipBalancedParens();\n  }",
