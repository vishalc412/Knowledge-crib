  "source": {
    "text": "function lastIdentifier(lhs: string): string {\n  const m = /([A-Za-z_]\\w*)\\s*$/.exec(lhs);\n  if (m) return m[1] ?? lhs;\n  // indexed target `a[i] = …` → return the indexer root `a`\n  const idx = /([A-Za-z_]\\w*)\\s*\\[/.exec(lhs);\n  return idx ? (idx[1] ?? lhs) : lhs;\n}",
