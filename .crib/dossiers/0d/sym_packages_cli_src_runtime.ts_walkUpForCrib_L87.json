  "source": {
    "text": "export function walkUpForCrib(start: string): string | undefined {\n  let dir = resolve(start);\n  // guard against a symlink/`..` loop: stop at the filesystem root.\n  for (let i = 0; i < 128; i++) {\n    if (existsSync(join(dir, '.crib', 'crib.json'))) return dir;\n    const parent = dirname(dir);\n    if (parent === dir) return undefined; // reached root\n    dir = parent;\n  }\n  return undefined;\n}",
    "truncated": false,
    "totalLines": 11,
    "startLine": 87
  },
