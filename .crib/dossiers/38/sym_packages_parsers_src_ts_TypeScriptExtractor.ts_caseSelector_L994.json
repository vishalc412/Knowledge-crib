    "text": "function caseSelector(expr: ts.Expression): string {\n  if (ts.isStringLiteral(expr)) return expr.text;\n  if (ts.isNumericLiteral(expr)) return expr.text;\n  return truncate(expr.getText(), EXPR_MAX_CHARS);\n}",
