  "source": {
    "text": "    const flush = (): void => {\n      if (lastName)\n        out.push(\n          firstName && firstName !== lastName\n            ? { name: lastName, type: firstName }\n            : { name: lastName },\n        );\n      firstName = undefined;\n      lastName = undefined;\n    };",
