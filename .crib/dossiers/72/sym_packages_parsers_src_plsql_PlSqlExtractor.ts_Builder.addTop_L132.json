  "source": {
    "text": "  addTop(top: TopLevel): void {\n    if (top.kind === 'table-ddl') {\n      this.addTable(top);\n      return;\n    }\n    if (top.kind === 'view-ddl') {\n      this.addView(top);\n      return;\n    }\n    if (top.kind === 'type-def') {\n      this.addType(top);\n      return;\n    }\n    this.addUnit(top, /*enclosingId*/ this.fileId, /*qualifier*/ '');\n  }",
