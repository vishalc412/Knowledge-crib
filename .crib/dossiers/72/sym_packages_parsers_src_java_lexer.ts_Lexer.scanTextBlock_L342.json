  "source": {
    "text": "  private scanTextBlock(sl: number, sc: number): void {\n    this.advance(); // 2nd \"\n    this.advance(); // 3rd \"\n    let value = '\"\"\"';\n    while (this.pos < this.src.length) {\n      const c = this.peek();\n      if (c === '\\\\') {\n        value += c;\n        this.advance();\n        if (this.pos < this.src.length) {\n          value += this.peek();\n          this.advance();\n        }\n        continue;\n      }\n      if (c === '\"' && this.peek(1) === '\"' && this.peek(2) === '\"') {\n        value += '\"\"\"';\n        this.advance();\n        this.advance();\n        this.advance();\n        break;\n      }\n      value += c;\n      this.advance();\n    }\n    this.emit('STRING', value, sl, sc);\n  }",
    "truncated": false,
    "totalLines": 27,
    "startLine": 342
  },
