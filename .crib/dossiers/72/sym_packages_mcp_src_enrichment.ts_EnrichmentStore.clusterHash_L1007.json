  "source": {
    "text": "  private clusterHash(cluster: Node): string {\n    const memberHashes = this.clusterMembers(cluster)\n      .map((n) => n.hash)\n      .sort();\n    return contentHash([cluster.hash, ...memberHashes].join('|'));\n  }",
