  "source": {
    "text": "  private atomicWrite(path: string, content: string): void {\n    mkdirSync(dirname(path), { recursive: true });\n    const tmp = `${path}.tmp`;\n    writeFileSync(tmp, content, 'utf8');\n    renameSync(tmp, path);\n  }",
