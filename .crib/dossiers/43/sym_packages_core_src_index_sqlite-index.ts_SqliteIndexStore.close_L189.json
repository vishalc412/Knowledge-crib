  "source": {
    "text": "  close(): void {\n    try {\n      this.db.pragma('wal_checkpoint(TRUNCATE)');\n    } catch {\n      // Best effort: in-memory/closing handles may not need or accept a checkpoint.\n    }\n    this.db.close();\n  }",
