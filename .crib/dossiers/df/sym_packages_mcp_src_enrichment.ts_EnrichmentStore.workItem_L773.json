  "source": {
    "text": "  private workItem(target: {\n    layer: EnrichLayer;\n    id: string;\n    hash: string;\n    node?: Node;\n  }): EnrichWorkItem {\n    return {\n      targetId: target.id,\n      seed: this.seed(target),\n      lowerLayer: this.lowerLayer(target),\n      outputSchema: outputSchema(target.layer),\n      instructions: instructionsFor(target.layer),\n    };\n  }",
