  "source": {
    "text": "  const consumeDotted = (k: number): { parts: string[]; j: number; star: boolean } => {\n    const parts: string[] = [];\n    let j = k;\n    let star = false;\n    while (j < tokens.length && tokens[j]!.type === 'NAME') {\n      parts.push(tokens[j]!.value);\n      j++;\n      if (isOp(j, '.')) {\n        // `.*` wildcard: dot then `*` (OP)\n        if (tokens[j + 1]?.type === 'OP' && tokens[j + 1]?.value === '*') {\n          j += 2;\n          star = true;\n          break;\n        }\n        j++;\n        continue;\n      }\n      break;\n    }\n    return { parts, j, star };\n  };",
    "truncated": false,
    "totalLines": 21,
    "startLine": 1024
  },
