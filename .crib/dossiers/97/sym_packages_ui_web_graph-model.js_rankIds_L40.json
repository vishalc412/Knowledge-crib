  "source": {
    "text": "  function rankIds(ids, byId) {\n    return [...ids].sort((a, b) => {\n      const an = byId[a] || {};\n      const bn = byId[b] || {};\n      return (\n        (bn.importance || 0) - (an.importance || 0) ||\n        String(an.qualified || an.label || a).localeCompare(String(bn.qualified || bn.label || b)) ||\n        a.localeCompare(b)\n      );\n    });\n  }",
