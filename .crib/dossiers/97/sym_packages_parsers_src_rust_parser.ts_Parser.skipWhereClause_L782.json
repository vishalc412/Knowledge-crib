  "source": {
    "text": "  private skipWhereClause(): void {\n    if (!this.isName('where')) return;\n    this.next();\n    while (!this.atEnd()) {\n      if (this.isOp('{') || this.isOp(';')) return;\n      // a `where` bound ends at the body; balance `<...>` so `Vec<T>:` doesn't confuse us\n      if (this.isOp('<')) {\n        this.skipGenericAngle();\n        continue;\n      }\n      this.next();\n    }\n  }",
    "truncated": false,
    "totalLines": 13,
    "startLine": 782
  },
