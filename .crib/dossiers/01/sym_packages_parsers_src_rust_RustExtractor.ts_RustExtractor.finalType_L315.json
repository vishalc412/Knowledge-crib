  "source": {
    "text": "  private finalType(d: RustDef, memberCtx: 'impl' | 'trait' | 'mod' | 'none'): string {\n    if (d.kind !== 'fn') return d.kind;\n    if (memberCtx === 'impl' || memberCtx === 'trait') {\n      return d.hasSelf ? 'method' : 'associated_fn';\n    }\n    return 'fn';\n  }",
