    "text": "function registerIndexed(repoRoot: string, cribDir: string, soul: SoulStore): void {\n  const m = soul.getManifest();\n  registerProject(repoRoot, {\n    repoId: m.repo.id,\n    cribDir,\n    ...(m.repo.vcsHead !== undefined ? { vcsHead: m.repo.vcsHead } : {}),\n  });\n}",
