  "source": {
    "text": "function countByFileCategory(rows: Array<Record<string, unknown>>): GapCategoryCounts {\n  const counts = initGapCategories();\n  for (const row of rows) {\n    const file =\n      typeof row.file === 'string'\n        ? row.file\n        : typeof row.callerFile === 'string'\n          ? row.callerFile\n          : undefined;\n    counts[fileCategory(file)]++;\n  }\n  return counts;\n}",
    "truncated": false,
    "totalLines": 13,
