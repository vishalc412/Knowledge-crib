  "source": {
    "text": "  private parseMacroRules(\n    startLine: number,\n    attributes: string[],\n    modifiers: string[],\n  ): RustDef | null {\n    this.next(); // macro_rules\n    if (this.isOp('!')) this.next();\n    let name = '<anon>';\n    if (this.isNameToken()) {\n      name = this.peek().value;\n      this.next();\n    }\n    let endLine = startLine;\n    if (this.isOp('{')) {\n      endLine = this.skipBraces();\n    } else if (this.isOp('(')) {\n      this.skipBalancedParens();\n      if (this.isOp(';')) this.next();\n      endLine = this.peek().line;\n    }\n    return {\n      kind: 'macro',\n      name,\n      startLine,\n      endLine: Math.max(endLine, startLine),\n      modifiers,\n      attributes,\n      bases: [],\n      typeParams: [],\n      params: [],\n      hasSelf: false,\n      body: [],\n    };\n  }",
    "truncated": false,
    "totalLines": 34,
    "startLine": 604
  },
