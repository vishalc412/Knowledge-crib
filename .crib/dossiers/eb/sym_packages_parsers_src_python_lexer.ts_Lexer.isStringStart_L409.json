  "source": {
    "text": "  private isStringStart(): boolean {\n    const c = this.peek();\n    if (c === '\"' || c === \"'\") return true;\n    // prefix + quote\n    if (isStringPrefix(c)) {\n      let i = 1;\n      while (isStringPrefix(this.peek(i))) i++;\n      const q = this.peek(i);\n      return q === '\"' || q === \"'\";\n    }\n    return false;\n  }",
    "truncated": false,
    "totalLines": 12,
    "startLine": 409
  },
