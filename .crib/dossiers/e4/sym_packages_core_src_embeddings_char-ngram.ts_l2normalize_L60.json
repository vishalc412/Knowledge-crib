  "source": {
    "text": "function l2normalize(v: Float32Array): Vec {\n  let norm = 0;\n  for (let i = 0; i < v.length; i++) norm += (v[i] ?? 0) * (v[i] ?? 0);\n  if (norm === 0) return v;\n  const inv = 1 / Math.sqrt(norm);\n  for (let i = 0; i < v.length; i++) v[i] = (v[i] ?? 0) * inv;\n  return v;\n}",
    "truncated": false,
    "totalLines": 8,
