  "source": {
    "text": "export function resolveBin(bin?: string): string {\n  if (bin) return resolve(bin);\n  try {\n    return execFileSync('which', ['crib'], {\n      encoding: 'utf8',\n      stdio: ['ignore', 'pipe', 'ignore'],\n    }).trim();\n  } catch {\n    return 'crib';\n  }\n}",
