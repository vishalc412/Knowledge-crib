    "text": "  private edge(src: string, dst: string, rel: Edge['rel'], snippet: string): Edge {\n    return {\n      id: edgeId(src, dst, rel),\n      src,\n      dst,\n      rel,\n      method: 'static',\n      provenance: 'EXTRACTED',\n      confidence: 1,\n      evidence: { by: this.name, snippet },\n    };\n  }",
