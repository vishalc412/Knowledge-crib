  "source": {
    "text": "  private bm25Query(q: HybridQuery, limit: number, offset: number): Hit[] {\n    const match = toFtsMatch(q.text);\n    if (!match) return [];\n    const kindFilter = q.kinds?.length\n      ? ` AND n.kind IN (${q.kinds.map(() => '?').join(',')})`\n      : '';\n    const rows = this.db\n      .prepare(\n        `SELECT n.id AS id, n.kind AS kind, n.name AS name, n.file AS file, bm25(nodes_fts) AS score\n         FROM nodes_fts\n         JOIN nodes n ON n.id = nodes_fts.id\n         WHERE nodes_fts MATCH ?${kindFilter}\n         ORDER BY score ASC\n         LIMIT ? OFFSET ?`,\n      )\n      .all(match, ...(q.kinds ?? []), limit, offset) as Array<{\n      id: string;\n      kind: NodeKind;\n      name: string | null;\n      file: string | null;\n      score: number;\n    }>;\n    return rows.map((r) => ({\n      id: r.id,\n      kind: r.kind,\n      score: r.score,\n      ...(r.name != null ? { name: r.name } : {}),\n      ...(r.file != null ? { file: r.file } : {}),\n    }));\n  }",
    "truncated": false,
    "totalLines": 30,
    "startLine": 199
  },
