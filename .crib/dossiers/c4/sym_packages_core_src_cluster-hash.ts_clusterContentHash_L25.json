  "source": {
    "text": "export function clusterContentHash(soul: SoulStore, cluster: Node): string {\n  const memberHashes = clusterMembers(soul, cluster)\n    .map((n) => n.hash)\n    .sort();\n  return contentHash([cluster.hash, ...memberHashes].join('|'));\n}",
