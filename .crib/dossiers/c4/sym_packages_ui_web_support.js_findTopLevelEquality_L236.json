  "source": {
    "text": "  function findTopLevelEquality(expr) {\n    let depth = 0;\n    for (let i = 0; i < expr.length; i++) {\n      const c = expr[i];\n      if (c === \"[\" || c === \"(\") depth++;\n      else if (c === \"]\" || c === \")\") depth--;\n      else if (depth === 0 && (c === \"=\" || c === \"!\") && expr[i + 1] === \"=\") {\n        if (i > 0 && (expr[i - 1] === \"=\" || expr[i - 1] === \"!\")) continue;\n        if (!expr.slice(0, i).trim()) continue;\n        const op = expr[i + 2] === \"=\" ? c + \"==\" : c + \"=\";\n        return { index: i, op };\n      }\n    }\n    return null;\n  }",
    "truncated": false,
