  "source": {
    "text": "export function discoverFiles(root: string, opts: DiscoverOpts = {}): FileMeta[] {\n  const ignores = opts.ignores ?? DEFAULT_IGNORES;\n  const out: FileMeta[] = [];\n  const walk = (dir: string): void => {\n    for (const entry of readdirSync(dir)) {\n      if (ignores.has(entry)) continue;\n      const abs = join(dir, entry);\n      const st = statSync(abs);\n      if (st.isDirectory()) {\n        walk(abs);\n      } else if (st.isFile()) {\n        const rel = toPosix(relative(root, abs));\n        out.push({ path: rel, lang: langForPath(rel), bytes: st.size, mtime: st.mtimeMs });\n      }\n    }\n  };\n  walk(root);\n  return out.sort((a, b) => (a.path < b.path ? -1 : a.path > b.path ? 1 : 0));\n}",
    "truncated": false,
    "totalLines": 19,
