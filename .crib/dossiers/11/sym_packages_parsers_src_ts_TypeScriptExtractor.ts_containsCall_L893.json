  "source": {
    "text": "function containsCall(node: ts.Node): boolean {\n  if (ts.isCallExpression(node)) return true;\n  let found = false;\n  ts.forEachChild(node, (c) => {\n    if (!found) found = containsCall(c);\n  });\n  return found;\n}",
