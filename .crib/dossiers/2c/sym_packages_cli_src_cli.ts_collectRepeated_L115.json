  "source": {
    "text": "function collectRepeated(args: string[], flag: string): string[] {\n  const out: string[] = [];\n  for (let i = 0; i < args.length; i++) {\n    if (args[i] === flag) {\n      const v = args[i + 1];\n      if (v && !v.startsWith('-')) out.push(v);\n    }\n  }\n  return out;\n}",
