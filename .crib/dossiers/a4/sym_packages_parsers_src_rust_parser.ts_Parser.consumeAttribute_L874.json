  "source": {
    "text": "  private consumeAttribute(out: string[]): void {\n    this.next(); // #\n    if (this.isOp('!')) this.next(); // inner `#![...]`\n    if (this.isOp('[')) {\n      this.attrBuf.length = 0;\n      this.skipBalancedBrackets();\n      if (this.attrBuf.length) out.push(this.attrBuf[0]!);\n    }\n  }",
