  "source": {
    "text": "function updateBlockDepth(line: string, depth: number): number {\n  let d = depth;\n  for (let k = 0; k < line.length; k++) {\n    if (line[k] === '/' && line[k + 1] === '*') {\n      d++;\n      k++;\n    } else if (line[k] === '*' && line[k + 1] === '/') {\n      d--;\n      k++;\n    }\n  }\n  return d;\n}",
