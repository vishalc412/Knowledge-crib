  "source": {
    "text": "  private scanInterpolatedString(prefixLen: number): void {\n    const sl = this.line;\n    const sc = this.col;\n    for (let k = 0; k < prefixLen; k++) this.advance(); // `$`\n    this.advance(); // opening \"\n    let value = '$\"';\n    while (this.pos < this.src.length) {\n      const c = this.peek();\n      if (c === '\\\\') {\n        value += c;\n        this.advance();\n        if (this.pos < this.src.length) {\n          value += this.peek();\n          this.advance();\n        }\n        continue;\n      }\n      if (c === '\\n' || c === '\\r') break; // unterminated — tolerate\n      if (c === '{') {\n        if (this.peek(1) === '{') {\n          value += '{{';\n          this.advance();\n          this.advance();\n          continue;\n        }\n        value += this.scanInterpolationHole();\n        continue;\n      }\n      if (c === '}') {\n        if (this.peek(1) === '}') {\n          value += '}}';\n          this.advance();\n          this.advance();\n          continue;\n        }\n        value += c;\n        this.advance();\n        continue;\n      }\n      value += c;\n      this.advance();\n      if (c === '\"') break;\n    }\n    this.emit('STRING', value, sl, sc);\n  }",
    "truncated": false,
    "totalLines": 45,
    "startLine": 402
  },
