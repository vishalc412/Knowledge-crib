    "text": "  release(): void {\n    if (!this.held) return;\n    this.held = false;\n    try {\n      if (this.readHolder() === process.pid && existsSync(this.path)) {\n        unlinkSync(this.path);\n      }\n    } catch {\n      // best-effort: a failed unlink leaves a stale lock the next acquire recovers from\n    }\n  }",
