  "source": {
    "text": "  private parseStmtBody(): CsharpStmt[] {\n    if (this.isOp('{')) {\n      this.next(); // {\n      const list = this.parseStmtList();\n      if (this.isOp('}')) this.next();\n      return list;\n    }\n    const s = this.parseStmt();\n    return s ? [s] : [];\n  }",
