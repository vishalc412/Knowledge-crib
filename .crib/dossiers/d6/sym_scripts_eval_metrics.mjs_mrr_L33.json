  "source": {
    "text": "export function mrr(retrieved, expected) {\n  const want = new Set(expected);\n  for (let i = 0; i < retrieved.length; i += 1) {\n    if (want.has(retrieved[i])) return 1 / (i + 1);\n  }\n  return 0;\n}",
