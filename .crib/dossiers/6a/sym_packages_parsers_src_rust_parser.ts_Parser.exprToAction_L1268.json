  "source": {
    "text": "  private exprToAction(line: number, start: number, end: number): RustStmt[] {\n    const text = this.sliceTokens(start, end).trim();\n    if (!text) return [];\n    const call = this.findFirstCall(start, end);\n    if (!call) return []; // plain expr / pure assignment — skip (lean graph)\n    if (call.macro && call.callee === 'panic') {\n      const msg = this.findFirstString(start, end);\n      return [\n        {\n          kind: 'throw',\n          line: call.line,\n          text: text.slice(0, EXPR_MAX_CHARS),\n          ...(msg ? { errorMessage: msg } : {}),\n        },\n      ];\n    }\n    return [\n      { kind: 'call', line: call.line, text: text.slice(0, EXPR_MAX_CHARS), callee: call.callee },\n    ];\n  }",
    "truncated": false,
    "totalLines": 20,
    "startLine": 1268
  },
