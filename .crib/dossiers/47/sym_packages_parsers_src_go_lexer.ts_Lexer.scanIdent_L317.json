  "source": {
    "text": "  private scanIdent(): void {\n    const start = this.pos;\n    const sl = this.line;\n    const sc = this.col;\n    while (this.pos < this.src.length && this.isIdentPart(this.peek())) this.advance();\n    this.emit('NAME', this.src.slice(start, this.pos), sl, sc);\n  }",
