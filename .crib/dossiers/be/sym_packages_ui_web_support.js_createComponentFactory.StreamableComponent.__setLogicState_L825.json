    "text": "      __setLogicState(update, cb) {\n        const prev = this.logic.state;\n        const patch = typeof update === \"function\" ? update(prev) : update;\n        this.logic.state = { ...prev, ...patch };\n        this.setState((s) => ({ __v: s.__v + 1 }), cb);\n      }",
