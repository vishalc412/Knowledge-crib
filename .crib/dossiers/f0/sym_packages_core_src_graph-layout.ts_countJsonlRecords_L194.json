  "source": {
    "text": "function countJsonlRecords(root: string): number {\n  let count = 0;\n  for (const file of walkFiles(root).filter((path) => path.endsWith('.jsonl'))) {\n    count += readFileSync(file, 'utf8').split('\\n').filter(Boolean).length;\n  }\n  return count;\n}",
