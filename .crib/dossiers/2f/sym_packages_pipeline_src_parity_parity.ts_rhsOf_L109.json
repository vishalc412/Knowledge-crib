  "source": {
    "text": "function rhsOf(expr: string): string {\n  for (let i = 0; i < expr.length; i++) {\n    if (expr[i] !== '=') continue;\n    const prev = expr[i - 1];\n    const next = expr[i + 1];\n    // skip ==, >=, <=, !=, and => (arrow)\n    if (next === '=' || prev === '=' || prev === '!' || prev === '>' || prev === '<') continue;\n    return expr.slice(i + 1).trim();\n  }\n  return expr; // no standalone assignment = → already RHS (PL/SQL case)\n}",
    "truncated": false,
    "totalLines": 11,
