  "source": {
    "text": "  private findCallInRun(run: Token[]): GoCallee | undefined {\n    let i = 0;\n    while (i < run.length) {\n      const tk = run[i]!;\n      if (tk.type !== 'NAME') {\n        i++;\n        continue;\n      }\n      const chain: string[] = [tk.value];\n      let j = i + 1;\n      while (\n        j + 1 < run.length &&\n        run[j]!.type === 'OP' &&\n        run[j]!.value === '.' &&\n        run[j + 1]!.type === 'NAME'\n      ) {\n        chain.push(run[j + 1]!.value);\n        j += 2;\n      }\n      if (j < run.length && run[j]!.type === 'OP' && run[j]!.value === '(') {\n        return {\n          head: chain[0]!,\n          tail: chain.slice(1),\n          name: chain[chain.length - 1]!,\n          line: tk.line,\n        };\n      }\n      i++;\n    }\n    return undefined;\n  }",
    "truncated": false,
    "totalLines": 31,
