    "text": "  private resolveLocalSymbol(callee: string): string | undefined {\n    if (this.symbols.has(callee)) return this.symbols.get(callee);\n    const last = callee.split('.').pop() ?? callee;\n    return this.symbols.get(last);\n  }",
