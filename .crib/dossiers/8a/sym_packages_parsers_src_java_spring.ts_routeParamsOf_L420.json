  "source": {
    "text": "function routeParamsOf(m: JavaDef): Array<{ name: string; type?: string; in: string }> {\n  const out: Array<{ name: string; type?: string; in: string }> = [];\n  const names = m.params ?? [];\n  const types = m.paramTypes ?? [];\n  const annosList = m.paramAnnos ?? [];\n  for (let i = 0; i < names.length; i++) {\n    const annos = annosList[i] ?? [];\n    const binding = annos.find((a) => PARAM_BINDING[a]);\n    if (!binding) continue;\n    out.push({ name: names[i]!, ...(types[i] ? { type: types[i] } : {}), in: PARAM_BINDING[binding]! });\n  }\n  return out;\n}",
    "truncated": false,
