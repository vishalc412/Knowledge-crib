  "source": {
    "text": "  private readRecords<T>(file: string): T[] {\n    const text = readFileSync(file, 'utf8');\n    const out: T[] = [];\n    for (const line of text.split('\\n')) {\n      if (line.length === 0) continue;\n      out.push(JSON.parse(line) as T);\n    }\n    return out;\n  }",
