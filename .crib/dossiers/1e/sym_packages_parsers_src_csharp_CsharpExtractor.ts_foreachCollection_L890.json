  "source": {
    "text": "function foreachCollection(predicate: string): string | undefined {\n  const m = /\\bin\\b\\s+(.+)$/.exec(predicate);\n  if (!m) return undefined;\n  const coll = (m[1] ?? '').trim();\n  return /^[A-Za-z_]\\w*$/.test(coll) ? coll : undefined;\n}",
