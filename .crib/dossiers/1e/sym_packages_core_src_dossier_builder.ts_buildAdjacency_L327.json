  "source": {
    "text": "function buildAdjacency(soul: SoulStore, key: (e: Edge) => string): Map<string, Edge[]> {\n  const map = new Map<string, Edge[]>();\n  for (const e of soul.iterateEdges()) {\n    const k = key(e);\n    const list = map.get(k);\n    if (list) list.push(e);\n    else map.set(k, [e]);\n  }\n  return map;\n}",
    "truncated": false,
    "totalLines": 10,
