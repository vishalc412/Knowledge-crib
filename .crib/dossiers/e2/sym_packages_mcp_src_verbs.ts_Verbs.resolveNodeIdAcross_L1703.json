  "source": {
    "text": "  private resolveNodeIdAcross(\n    fed: Federation,\n    idOrName: string,\n    primaryRoot: string,\n  ): string | undefined {\n    const primary = fed.souls.find((s) => s.root === primaryRoot);\n    if (!primary) return undefined;\n    return resolveIdInSoul(primary.soul, idOrName);\n  }",
