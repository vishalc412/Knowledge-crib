  "source": {
    "text": "  private skipBalancedInSlice(openIdx: number): number {\n    const open = this.t[openIdx]?.value;\n    const close = open === '(' ? ')' : open === '[' ? ']' : '';\n    let j = openIdx + 1;\n    let d = 1;\n    const n = this.t.length;\n    while (j < n && d > 0) {\n      const tk = this.t[j]!;\n      if (tk.type === 'OP' && tk.value === open) d++;\n      else if (tk.type === 'OP' && tk.value === close) d--;\n      j++;\n    }\n    return j;\n  }",
    "truncated": false,
    "totalLines": 14,
    "startLine": 1428
  },
