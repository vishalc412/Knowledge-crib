  "source": {
    "text": "function extractLinks(body: string): string[] {\n  const links = new Set<string>();\n  for (const m of body.matchAll(MD_LINK)) {\n    const target = (m[1] ?? '').trim();\n    if (target && !target.startsWith('#') && !target.startsWith('http')) links.add(target);\n  }\n  return [...links];\n}",
