  "source": {
    "text": "export function exportGraph(soul: SoulStore): GraphJson {\n  const nodes = [...soul.iterate()];\n  const edges = [...soul.iterateEdges()];\n  return {\n    schemaVersion: soul.getManifest().schemaVersion,\n    stats: { nodes: nodes.length, edges: edges.length },\n    nodes,\n    edges,\n  };\n}",
