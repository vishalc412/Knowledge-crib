  "source": {
    "text": "function uniqueRoots(roots: string[]): string[] {\n  const seen = new Set<string>();\n  const out: string[] = [];\n  for (const r of roots) {\n    if (!r) continue;\n    if (seen.has(r)) continue;\n    seen.add(r);\n    out.push(r);\n  }\n  return out;\n}",
    "truncated": false,
    "totalLines": 11,
    "startLine": 1892
  },
