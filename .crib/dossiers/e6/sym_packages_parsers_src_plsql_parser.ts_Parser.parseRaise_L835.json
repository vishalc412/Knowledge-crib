  "source": {
    "text": "  private parseRaise(): RaiseStmt {\n    const startLine = this.lineOf();\n    this.eatWord('raise');\n    let name = '';\n    if (this.at().type === 'word') name = this.next().raw;\n    this.skipToSemicolon();\n    return { kind: 'raise', name, span: { start: startLine, end: this.lineOf() } };\n  }",
    "truncated": false,
    "totalLines": 8,
    "startLine": 835
  },
