  "source": {
    "text": "  private matchParen(openIdx: number, maxIdx: number = this.t.length): number {\n    let depth = 0;\n    for (let j = openIdx; j < maxIdx; j++) {\n      const tk = this.t[j]!;\n      if (tk.type === 'EOF') return -1;\n      if (tk.type === 'OP' && tk.value === '(') depth++;\n      else if (tk.type === 'OP' && tk.value === ')') {\n        depth--;\n        if (depth === 0) return j;\n      }\n    }\n    return -1;\n  }",
    "truncated": false,
    "totalLines": 13,
    "startLine": 1625
  },
