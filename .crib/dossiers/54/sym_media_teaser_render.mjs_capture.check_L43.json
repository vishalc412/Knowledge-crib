  "source": {
    "text": "    const check = () => {\n      if (existsSync(target) && statSync(target).size > 1_000) {\n        stop();\n        resolve();\n        return;\n      }\n      if (Date.now() - started > 20_000) {\n        stop();\n        reject(new Error(`Timed out capturing scene ${scene}`));\n        return;\n      }\n      setTimeout(check, 100);\n    };",
    "truncated": false,
