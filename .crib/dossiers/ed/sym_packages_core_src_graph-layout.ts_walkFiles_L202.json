  "source": {
    "text": "function walkFiles(root: string): string[] {\n  if (!existsSync(root)) return [];\n  const files: string[] = [];\n  const stack = [root];\n  while (stack.length > 0) {\n    const dir = stack.pop()!;\n    for (const entry of requireEntries(dir)) {\n      if (entry.directory) stack.push(entry.path);\n      else files.push(entry.path);\n    }\n  }\n  return files;\n}",
    "truncated": false,
    "totalLines": 13,
    "startLine": 202
  },
