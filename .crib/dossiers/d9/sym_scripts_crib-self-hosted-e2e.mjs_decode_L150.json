  "source": {
    "text": "function decode(result) {\n  const text = result?.content?.find((item) => item.type === 'text')?.text;\n  if (typeof text !== 'string') return result;\n  try {\n    return JSON.parse(text);\n  } catch {\n    return { text };\n  }\n}",
