  "source": {
    "text": "  private wrapBlockAsPlain(_b: Block, startLine: number): Stmt {\n    // parseAnonymousBlock already consumed the nested block's terminating `;`; only eat one if it's\n    // still pending (a malformed nested block with no terminator). Never skip past a `;` that\n    // belongs to the NEXT statement — that would swallow a trailing top-level SELECT.\n    this.eatPunct(';');\n    return { kind: 'plain', head: 'BLOCK', span: { start: startLine, end: this.lineOf() } };\n  }",
    "truncated": false,
    "totalLines": 7,
    "startLine": 1078
  },
