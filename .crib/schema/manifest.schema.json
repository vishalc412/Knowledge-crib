{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://knowledge-crib.dev/schema/1.0/manifest.schema.json",
  "title": "Manifest",
  "description": "The .crib/crib.json manifest: versions, repo id, chunking, stores, stats, capabilities.",
  "type": "object",
  "required": [
    "cribFormatVersion",
    "schemaVersion",
    "repo",
    "generator",
    "chunking",
    "stores",
    "stats",
    "capabilities"
  ],
  "properties": {
    "cribFormatVersion": {
      "type": "string"
    },
    "schemaVersion": {
      "type": "string"
    },
    "repo": {
      "type": "object",
      "required": [
        "id",
        "root"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "root": {
          "type": "string"
        },
        "vcsHead": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "generator": {
      "type": "object",
      "required": [
        "tool",
        "version"
      ],
      "properties": {
        "tool": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "chunking": {
      "type": "object",
      "required": [
        "shardHexDigits",
        "maxChunkLines",
        "format"
      ],
      "properties": {
        "shardHexDigits": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "maxChunkLines": {
          "type": "integer",
          "minimum": 1
        },
        "format": {
          "type": "string",
          "const": "jsonl"
        }
      },
      "additionalProperties": true
    },
    "stores": {
      "type": "object",
      "required": [
        "soul",
        "index"
      ],
      "properties": {
        "soul": {
          "type": "string",
          "const": "jsonl-chunked"
        },
        "index": {
          "type": "object",
          "required": [
            "backend",
            "path"
          ],
          "properties": {
            "backend": {
              "type": "string",
              "enum": [
                "sqlite",
                "kuzu"
              ]
            },
            "path": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "stats": {
      "type": "object",
      "required": [
        "nodes",
        "edges",
        "clusters",
        "lastUpdated"
      ],
      "properties": {
        "nodes": {
          "type": "integer",
          "minimum": 0
        },
        "edges": {
          "type": "integer",
          "minimum": 0
        },
        "clusters": {
          "type": "integer",
          "minimum": 0
        },
        "lastUpdated": {
          "type": "string"
        },
        "incrementalSince": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "capabilities": {
      "type": "object",
      "required": [
        "embeddings",
        "multimodal"
      ],
      "properties": {
        "embeddings": {
          "type": "boolean"
        },
        "multimodal": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "meta": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
