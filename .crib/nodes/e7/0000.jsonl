{"id":"stmt:packages/pipeline/src/resolve/ts-resolver.ts@L61","kind":"statement","type":"assign","expr":"const push = (src: string, dst: string, rel: Rel, snippet: string): void => {\n    const id = edgeId(src, dst, rel);\n    if (seen.has(id)) return;\n    seen.add(id);\n    edges.push({\n      id,\n      src,\n      dst,\n      rel,\n      method: 'static',\n      provenance: 'EXTRACTED',\n      confidence: 1,\n      evidence: { by: 'ts-resolver', snippet },\n    });\n  };","file":"packages/pipeline/src/resolve/ts-resolver.ts","span":{"start":61,"end":61},"lang":"typescript","hash":"blake3:d26fe68c34b87131d40cf671286b7473f153aca72b7de89f2122f174567ebfd1","meta":{"head":"call","inLoop":false,"inException":false}}
