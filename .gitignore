.pytest_cache/
.ruff_cache/
.mypy_cache/
# local model dirs for whisper/surya backends (never fetched by the worker; user-supplied)
python/models/

# Claude Code session state (machine-local)
.claude/

# Agent/tool session state (machine-local, never committed)
.codex/
.cursor/
.mcp.json
.playwright-mcp/
.superpowers/
claude/
.remember/
.gitnexus/

# Local demo/media assets (large binaries, never committed)
media/
outputs/

# The whole local knowledge-graph working directory. Every `crib index` rewrites thousands of files
# here, which buried real code changes under ~4,700 generated files in review and made `git status`
# unusable. It is all reproducible from source with `crib index .`, so it is build output, not
# source — the same reasoning that already excluded `.crib/index/`.
.crib/

# Codex tool state — machine-local, same reasoning.
.codex/
