{
  "name": "knowledge-crib",
  "version": "0.0.0",
  "private": true,
  "description": "A portable \"project soul\" for AI coding agents — a git-committable knowledge graph served over one MCP server.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "corepack pnpm@9.15.0 -r run build",
    "pretest": "corepack pnpm@9.15.0 -r run build",
    "test": "corepack pnpm@9.15.0 -r run test",
    "verify": "corepack pnpm@9.15.0 -r run build && corepack pnpm@9.15.0 -r run test && biome check .",
    "test:python": "node scripts/test-python.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "budget:check": "node scripts/budget-check.mjs",
    "bench": "node scripts/crib-bench.mjs",
    "bench:cost": "node scripts/crib-bench.mjs --out crib-cost-report.md",
    "cost:report": "node scripts/crib-cost-report.mjs",
    "ab:task": "node scripts/crib-ab-task.mjs",
    "cache:stability": "node scripts/crib-cache-stability.test.mjs",
    "check:mule-sample": "node scripts/check-mule-sample.mjs",
    "publish:dry-run": "corepack pnpm@9.15.0 -r publish --dry-run --no-git-checks",
    "installer:build": "node scripts/build-installers.mjs",
    "installer:smoke": "node scripts/install-smoke.mjs",
    "installer:test": "node scripts/build-installers.test.mjs && node scripts/install-smoke.test.mjs && node scripts/package-runtime-deps.test.mjs && node scripts/ci-workflow.test.mjs && node scripts/release-cli-smoke.test.mjs && node scripts/test-python.test.mjs && node scripts/budget-check.test.mjs && node scripts/crib-cache-stability.test.mjs && node scripts/crib-cost-report.test.mjs && node scripts/eval-check.test.mjs && node scripts/check-mule-sample.test.mjs",
    "release:metadata": "node scripts/release-metadata.test.mjs",
    "release:evidence": "node scripts/release-evidence.mjs --require-pass",
    "release:verify": "node scripts/release-verify.mjs",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "corepack pnpm@9.15.0 -r run typecheck",
    "clean": "corepack pnpm@9.15.0 -r exec rm -rf dist coverage .crib",
    "eval:check": "node scripts/eval-check.mjs",
    "eval:semantic": "node scripts/eval/semantic-retrieval-eval.mjs",
    "graph:accuracy": "corepack pnpm@9.15.0 --filter @knowledge-crib/core build && corepack pnpm@9.15.0 --filter @knowledge-crib/parsers build && corepack pnpm@9.15.0 --filter @knowledge-crib/pipeline build && node scripts/graph-accuracy.mjs",
    "sync:soak": "corepack pnpm@9.15.0 --filter @knowledge-crib/memory build && node scripts/sync-soak.mjs",
    "cost:gate": "node scripts/cost-gate.mjs",
    "swarm:gate": "node scripts/swarm/swarm-gate.mjs",
    "semantic:check": "node scripts/semantic-check.mjs",
    "rerank:check": "node scripts/rerank-check.mjs",
    "linker:check": "node scripts/linker-check.mjs",
    "alias:check": "node scripts/alias-check.mjs",
    "js-coverage:check": "node scripts/js-coverage-check.mjs",
    "ifhash:check": "node scripts/ifhash-check.mjs",
    "tier:check": "node scripts/tier-check.mjs",
    "ownership:check": "node scripts/ownership-check.mjs",
    "federation:check": "node scripts/federation-check.mjs",
    "stats:check": "node scripts/stats-check.mjs",
    "parallel:check": "node scripts/parallel-check.mjs",
    "fuzz:check": "node scripts/fuzz-check.mjs",
    "fuzz:nightly": "node scripts/fuzz-check.mjs --iterations 1000000",
    "scale:check": "node scripts/scale-bench.mjs --slice 20000 --out /tmp/crib-scale-gate.md",
    "scale:nightly": "node scripts/scale-bench.mjs --slices 10000,100000,500000,1000000",
    "security:check": "node scripts/security-doc-check.mjs",
    "security:battery": "corepack pnpm@9.15.0 --filter @knowledge-crib/memory test -- record-v2.test.ts promotion.test.ts store.test.ts sync/adapter.test.ts sync/engine.test.ts sync/queue.test.ts evaluator.test.ts && corepack pnpm@9.15.0 --filter @knowledge-crib/mcp test -- verbs-memory.test.ts verbs-memory-v2.test.ts && corepack pnpm@9.15.0 --dir packages/cli test -- memory-capture-hook.test.ts",
    "soul-refresh:check": "node scripts/soul-refresh-check.mjs",
    "onboarding:check": "node scripts/onboarding-check.mjs",
    "docs:stats": "node scripts/docs-stats.mjs",
    "docs:build": "node scripts/docs-site-build.mjs",
    "docs-site:check": "node scripts/docs-site-check.mjs",
    "capabilities:check": "node scripts/capabilities-check.mjs",
    "self-hosted:check": "corepack pnpm@9.15.0 build && node scripts/crib-self-hosted-e2e.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.5.0",
    "fast-check": "^4.9.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.6"
  },
  "pnpm": {
    "overrides": {
      "vite": "^6.4.3",
      "esbuild": "^0.25.0",
      "fast-uri": "^3.1.6",
      "ip-address": "^10.3.1",
      "hono": "^4.12.34",
      "@hono/node-server": "^1.19.15",
      "qs": "^6.16.0"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KnowledgeCrib/knowledge-crib.git"
  },
  "bugs": {
    "url": "https://github.com/KnowledgeCrib/knowledge-crib/issues"
  },
  "homepage": "https://github.com/KnowledgeCrib/knowledge-crib#readme",
  "keywords": ["mcp", "knowledge-graph", "code-analysis", "ai-agents", "cli"]
}
