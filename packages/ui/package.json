{
  "name": "@knowledge-crib/ui",
  "version": "0.0.0",
  "description": "M7 web graph viz — Cytoscape.js compound-node snapshot builder + static assets.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "web"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests --reporter=dot"
  },
  "dependencies": {
    "@knowledge-crib/soul-schema": "workspace:*",
    "@knowledge-crib/core": "workspace:*"
  },
  "devDependencies": {
    "cytoscape": "^3.34.0",
    "vitest": "^2.1.0"
  }
}
