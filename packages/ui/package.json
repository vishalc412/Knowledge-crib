{
  "name": "@knowledge-crib/ui",
  "version": "0.1.0",
  "description": "M7 web graph viz — Claude Design DC runtime snapshot builder + static assets.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "web", "LICENSE", "NOTICE", "!dist/**/*.test.*"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --reporter=dot"
  },
  "dependencies": {
    "@knowledge-crib/soul-schema": "workspace:*",
    "@knowledge-crib/core": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^2.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KnowledgeCrib/knowledge-crib.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/KnowledgeCrib/knowledge-crib/issues"
  },
  "homepage": "https://github.com/KnowledgeCrib/knowledge-crib#readme",
  "keywords": ["mcp", "knowledge-graph", "code-analysis", "ai-agents", "cli", "visualization"],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
