{
  "name": "@knowledge-crib/core",
  "version": "0.1.0",
  "description": "SoulStore (chunked JSONL source of truth) + IndexStore (derived fast cache) + GraphModel.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "LICENSE", "NOTICE", "!dist/**/*.test.*", "!src/**/*.test.ts"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --reporter=dot"
  },
  "dependencies": {
    "@knowledge-crib/soul-schema": "workspace:*",
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^2.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KnowledgeCrib/knowledge-crib.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/KnowledgeCrib/knowledge-crib/issues"
  },
  "homepage": "https://github.com/KnowledgeCrib/knowledge-crib#readme",
  "keywords": [
    "mcp",
    "knowledge-graph",
    "code-analysis",
    "ai-agents",
    "cli",
    "sqlite",
    "soul-store"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
