{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://knowledge-crib.dev/schema/memory-1/graph-entity.schema.json",
  "title": "GraphEntity",
  "description": "A connected-memory-graph node registration (WP-G1). Storage id is content-addressed from the identity seed; `ref` is the canonical traversal node id the corpus pre-registers.",
  "type": "object",
  "required": ["id", "schemaVersion", "kind", "name", "ref", "namespace", "scope", "provenance"],
  "properties": {
    "id": { "type": "string", "pattern": "^gent:[0-9a-f]+$" },
    "schemaVersion": { "type": "string", "const": "1" },
    "kind": {
      "type": "string",
      "enum": ["repository", "service", "concept", "artifact"]
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "minLength": 1
    },
    "ref": {
      "type": "string",
      "pattern": "^entity:[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
    },
    "namespace": {
      "type": "object",
      "required": ["principalId"],
      "properties": {
        "principalId": { "type": "string", "minLength": 1 },
        "workspaceId": { "type": "string", "minLength": 1 },
        "projectId": { "type": "string", "minLength": 1 },
        "agentProfileId": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "scope": { "$ref": "#/definitions/graphScope" },
    "members": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "labels": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "provenance": {
      "type": "object",
      "required": ["principalId", "deviceId", "actorId", "clientId"],
      "properties": {
        "principalId": { "type": "string", "minLength": 1 },
        "deviceId": { "type": "string", "minLength": 1 },
        "actorId": { "type": "string", "minLength": 1 },
        "agentId": { "type": "string" },
        "clientId": { "type": "string", "minLength": 1 },
        "sessionId": { "type": "string" },
        "tool": { "type": "string" }
      },
      "additionalProperties": false
    },
    "meta": { "type": "object" }
  },
  "additionalProperties": false,
  "definitions": {
    "graphScope": {
      "type": "object",
      "required": ["boundary"],
      "properties": {
        "boundary": { "type": "string", "enum": ["repo", "global"] },
        "repoId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "boundary": { "const": "repo" } } },
          "then": { "required": ["repoId"] }
        },
        {
          "if": { "properties": { "boundary": { "const": "global" } } },
          "then": { "not": { "required": ["repoId"] } }
        }
      ]
    }
  }
}
