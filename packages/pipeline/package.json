{
  "name": "@knowledge-crib/pipeline",
  "version": "0.1.0",
  "description": "The phased pipeline: structure → parse → resolve → doc-extract → link → cluster → index.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "LICENSE", "NOTICE", "!dist/**/*.test.*", "!src/**/*.test.ts"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --reporter=dot"
  },
  "dependencies": {
    "@knowledge-crib/core": "workspace:*",
    "@knowledge-crib/parsers": "workspace:*",
    "@knowledge-crib/soul-schema": "workspace:*",
    "typescript": "^5.6.0",
    "unpdf": "^1.8.1",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@types/yauzl": "^2.10.3",
    "@types/yazl": "^3.3.1",
    "vitest": "^3.2.6",
    "yazl": "^3.3.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KnowledgeCrib/knowledge-crib.git",
    "directory": "packages/pipeline"
  },
  "bugs": {
    "url": "https://github.com/KnowledgeCrib/knowledge-crib/issues"
  },
  "homepage": "https://github.com/KnowledgeCrib/knowledge-crib#readme",
  "keywords": [
    "mcp",
    "knowledge-graph",
    "code-analysis",
    "ai-agents",
    "cli",
    "indexing",
    "static-analysis"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
