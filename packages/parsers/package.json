{
  "name": "@knowledge-crib/parsers",
  "version": "0.1.0",
  "description": "Offline deterministic extractors for TypeScript, PL/SQL, Python, Java, C#, Go, Rust, PHP, and Markdown.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "grammars",
    "LICENSE",
    "NOTICE",
    "!dist/**/*.test.*",
    "!src/**/*.test.ts",
    "!dist/**/__probe__/**",
    "!src/**/__probe__/**"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --reporter=dot"
  },
  "dependencies": {
    "@knowledge-crib/soul-schema": "workspace:*",
    "typescript": "^7.0.2",
    "web-tree-sitter": "^0.20.8"
  },
  "devDependencies": {
    "@knowledge-crib/core": "workspace:*",
    "vitest": "^2.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KnowledgeCrib/knowledge-crib.git",
    "directory": "packages/parsers"
  },
  "bugs": {
    "url": "https://github.com/KnowledgeCrib/knowledge-crib/issues"
  },
  "homepage": "https://github.com/KnowledgeCrib/knowledge-crib#readme",
  "keywords": [
    "mcp",
    "knowledge-graph",
    "code-analysis",
    "ai-agents",
    "cli",
    "parsers",
    "static-analysis"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
