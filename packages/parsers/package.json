{
  "name": "@knowledge-crib/parsers",
  "version": "0.0.0",
  "description": "Extractor plugins: turn one file into nodes + intra-file edges. TypeScript, PL/SQL, Python, Markdown — all hand-rolled / compiler-API, pure-JS, offline.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --reporter=dot"
  },
  "dependencies": {
    "@knowledge-crib/soul-schema": "workspace:*",
    "typescript": "^5.6.0"
  },
  "devDependencies": {
    "vitest": "^2.1.0"
  }
}
