{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://knowledge-crib.dev/schema/1.0/edge.schema.json",
  "title": "Edge",
  "description": "A Knowledge-crib graph edge. Every edge carries method, provenance, confidence, evidence.",
  "type": "object",
  "required": ["id", "src", "dst", "rel", "method", "provenance", "confidence"],
  "properties": {
    "id": { "type": "string", "pattern": "^e:[0-9a-f]+$" },
    "src": { "type": "string", "minLength": 1 },
    "dst": { "type": "string", "minLength": 1 },
    "rel": {
      "type": "string",
      "enum": [
        "calls",
        "imports",
        "inherits",
        "implements",
        "describes",
        "references",
        "derived-from",
        "member-of",
        "executes",
        "reads",
        "writes",
        "guarded-by",
        "raises",
        "handles",
        "iterates",
        "declares",
        "exposes",
        "injects",
        "renders",
        "produces",
        "owned-by",
        "governs",
        "requires",
        "invokes"
      ]
    },
    "method": {
      "type": "string",
      "enum": ["static", "explicit", "identifier", "path", "semantic", "inferred"]
    },
    "provenance": { "type": "string", "enum": ["EXTRACTED", "INFERRED"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "evidence": { "type": "object" },
    "guard": { "type": "string" },
    "cfgPath": { "type": "array", "items": { "type": "string" } },
    "branch": { "type": "string" },
    "inLoop": { "type": "boolean" },
    "inException": { "type": "boolean" },
    "meta": { "type": "object" }
  },
  "additionalProperties": true
}
